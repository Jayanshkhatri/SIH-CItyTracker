# ============================================================
# ANPR Analytics Engine - production environment EXAMPLE
# ------------------------------------------------------------
# Copy to .env locally and fill in real values. NEVER commit .env.
# ============================================================

# --- API authentication ---
# Generate with: python scripts/generate_key.py
# Clients send: X-API-Key: <this key>
ANALYTICS_API_KEY=

# --- REAL PostgreSQL / PostGIS connection ---
# These fields are preferred over DATABASE_URL because passwords can contain
# URL-special characters without manual URL encoding.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Optional browser CORS ---
# Comma-separated dashboard origin(s), e.g. https://dashboard.example.com
# Leave empty if the dashboard talks through its own backend/proxy.
CORS_ORIGINS=

# --- Analytics thresholds ---
DENSITY_LOW_THRESHOLD=10
DENSITY_HIGH_THRESHOLD=30
CONGESTION_THRESHOLD=1.5
DEFAULT_BUCKET_MINUTES=15
