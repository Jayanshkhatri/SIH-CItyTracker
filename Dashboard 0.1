<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grid Watch — Camera Network Monitor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  :root{
    --bg: #37414A;
    --bg-grad: radial-gradient(1200px 600px at 15% -10%, rgba(79,176,165,0.10), transparent),
                radial-gradient(900px 500px at 100% 0%, rgba(201,123,74,0.06), transparent);
    --panel: #3F4A54;
    --panel-2: #48545F;
    --panel-raised: #526069;
    --line: #5C6B74;
    --line-soft: rgba(92,107,116,0.55);
    --text: #F4F7F7;
    --text-dim: #CDD7DA;
    --muted: #94A5AB;
    --ink: #20262B;
    --gold: #C97B4A;
    --gold-soft: rgba(201,123,74,0.18);
    --blue: #4FB0A5;
    --blue-soft: rgba(79,176,165,0.18);
    --red: #D9695C;
    --red-soft: rgba(217,105,92,0.16);
    --green: #6BBF8A;
    --green-soft: rgba(107,191,138,0.16);
    --shadow: 0 1px 2px rgba(0,0,0,0.14), 0 10px 24px -12px rgba(0,0,0,0.34);
    --radius: 10px;
  }
  *{ box-sizing: border-box; }
  ::selection{ background: rgba(91,159,227,0.35); }
  body{
    margin:0;
    background: var(--bg-grad), var(--bg);
    color: var(--text);
    font-family: 'Sora', sans-serif;
    font-size: 14.5px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .mono{ font-family: 'IBM Plex Mono', monospace; font-feature-settings: "ss01"; }

  header{
    position: sticky;
    top: 0;
    z-index: 900;
    padding: 20px 32px;
    border-bottom: 1px solid var(--line);
    background: rgba(55,65,74,0.9);
    backdrop-filter: blur(10px);
    display:flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand{ display:flex; align-items:center; gap: 12px; }
  .brand-mark{
    width: 34px; height: 34px;
    border-radius: 9px;
    background: linear-gradient(145deg, var(--blue), #2f5f96);
    display:flex; align-items:center; justify-content:center;
    box-shadow: var(--shadow);
    flex-shrink: 0;
  }
  .brand-mark svg{ width: 18px; height:18px; }
  header h1{
    margin:0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.1px;
    color: var(--text);
  }
  header h1 span{ color: var(--gold); font-weight: 800; }
  header .subtitle{
    font-size: 11.5px;
    color: var(--muted);
    font-weight: 500;
    margin-top: 1px;
  }
  header .status{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--text-dim);
    display:flex;
    align-items:center;
    gap: 8px;
    background: var(--panel-2);
    border: 1px solid var(--line);
    padding: 7px 14px;
    border-radius: 20px;
  }
  .dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-soft);
  }

  main.content{
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .panel{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .panel-head{
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    background: linear-gradient(180deg, rgba(255,255,255,0.015), transparent);
  }
  .panel-head-left{ display:flex; align-items:center; gap: 12px; }
  .step-num{
    width: 26px; height: 26px;
    border-radius: 7px;
    background: var(--blue-soft);
    color: var(--blue);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    display:flex; align-items:center; justify-content:center;
    flex-shrink: 0;
  }
  .panel-head h2{
    margin:0;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.1px;
  }
  .panel-head .hint{
    font-size: 12px;
    color: var(--muted);
    font-weight: 500;
  }
  .panel-body{ padding: 22px; }

  /* Search */
  .search-row{
    display:flex;
    gap: 10px;
  }
  input[type="text"], select, textarea{
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 7px;
    padding: 10px 13px;
    font-family: 'Sora', sans-serif;
    font-size: 13.5px;
    font-weight: 500;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input[type="text"]::placeholder, textarea::placeholder{ color: var(--muted); font-weight: 400; }
  input[type="text"]:focus, select:focus, textarea:focus{
    border-color: var(--blue);
    box-shadow: 0 0 0 3px var(--blue-soft);
  }
  .search-row input{ flex:1; }
  button{
    background: var(--gold);
    color: #241A08;
    border: none;
    border-radius: 7px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13.5px;
    cursor: pointer;
    font-family: 'Sora', sans-serif;
    transition: filter 0.15s ease, transform 0.05s ease;
    white-space: nowrap;
  }
  button:hover{ filter: brightness(1.08); }
  button:active{ transform: translateY(1px); }
  button.ghost{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-dim);
    font-weight: 600;
  }
  button.ghost:hover{ border-color: var(--blue); color: var(--text); filter:none; }
  .search-tags{
    margin-top: 12px;
    display:flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--text-dim);
    border: 1px solid var(--line);
    background: var(--panel-2);
    padding: 4px 11px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tag:hover{ color: var(--blue); border-color: var(--blue); background: var(--blue-soft); }

  .divider{
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .field-label{
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text-dim);
    display:block;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* Table */
  table{ width:100%; border-collapse: collapse; }
  thead th{
    text-align:left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    padding: 0 14px 12px;
    font-weight: 700;
    border-bottom: 1px solid var(--line);
  }
  tbody td{
    padding: 12px 14px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 13.5px;
    vertical-align: middle;
    color: var(--text-dim);
  }
  tbody tr:hover{ background: rgba(91,159,227,0.05); }
  tbody tr:last-child td{ border-bottom: none; }
  .badge{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
    display:inline-block;
  }
  .badge.high{ background: var(--red-soft); color: var(--red); }
  .badge.med{ background: var(--gold-soft); color: var(--gold); }
  .badge.low{ background: var(--green-soft); color: var(--green); }
  .empty-row td{
    color: var(--muted);
    text-align:center;
    padding: 32px 14px;
    font-size: 13.5px;
  }

  /* map + legend */
  .map-wrap{ position: relative; }
  #map{ height: 440px; width: 100%; }
  .legend{
    position:absolute;
    bottom: 16px;
    left: 16px;
    z-index: 500;
    background: rgba(63,74,84,0.95);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 11.5px;
    color: var(--text-dim);
    display:flex;
    flex-direction: column;
    gap: 7px;
    box-shadow: var(--shadow);
  }
  .legend-item{ display:flex; align-items:center; gap: 9px; font-weight: 500; }
  .legend-swatch{ width:11px; height:11px; border-radius: 50%; flex-shrink:0; }
  .legend-line{ width:16px; height:3px; border-radius:2px; flex-shrink:0; }
  .legend-heat{
    width:16px; height:11px;
    background: linear-gradient(90deg, #3A5B62, #4FB0A5, #C97B4A, #D9695C);
    border-radius: 3px;
    flex-shrink:0;
  }
  .map-controls{
    display:flex; gap: 8px;
  }

  /* watchlist — stacked top to bottom */
  .watchlist-stack{
    display:flex;
    flex-direction: column;
    gap: 22px;
  }
  form.watchlist-form{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  form.watchlist-form .full{ grid-column: 1 / -1; }
  form.watchlist-form label{
    font-size: 11.5px;
    color: var(--muted);
    display:block;
    margin-bottom: 6px;
    font-weight: 600;
  }
  form.watchlist-form input, form.watchlist-form select, form.watchlist-form textarea{ width: 100%; }
  form.watchlist-form .submit-row{ grid-column: 1 / -1; display:flex; justify-content:flex-end; margin-top: 2px; }

  .wl-list-head{
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .wl-item{
    display:flex;
    justify-content: space-between;
    align-items:center;
    padding: 13px 16px;
    border: 1px solid var(--line);
    background: var(--panel-2);
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .wl-item .name{ font-weight: 700; font-size: 13.5px; display:flex; align-items:center; gap: 10px; }
  .wl-item .meta{ font-size: 11.5px; color: var(--muted); font-family: 'IBM Plex Mono', monospace; margin-top: 4px; }
  .wl-item button{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--red);
    padding: 6px 12px;
    font-size: 11.5px;
    font-weight: 600;
  }
  .wl-item button:hover{ border-color: var(--red); background: var(--red-soft); filter:none; }
  .priority{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 20px;
  }

  @media (max-width: 780px){
    form.watchlist-form{ grid-template-columns: 1fr; }
    header{ padding: 16px 20px; }
    main{ padding: 20px 16px 60px; }
    .panel-body{ padding: 16px; }
  }

  /* progress bar */
  .progress-bar{
    position: fixed;
    top: 0; left: 0;
    height: 2.5px;
    width: 0%;
    background: linear-gradient(90deg, var(--blue), var(--gold));
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  /* layout: nav rail + content, top to bottom flow inside content */
  .layout{
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px 32px 80px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
  }
  .content{
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  /* (layout grid below positions nav-rail + content side by side) */

  /* vertical nav rail — sections listed top to bottom */
  .nav-rail{
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-rail-line{
    position: absolute;
    left: 21px;
    top: 8px;
    bottom: 8px;
    width: 1.5px;
    background: var(--line);
    z-index: 0;
  }
  .nav-item{
    position: relative;
    z-index: 1;
    display:flex;
    align-items:center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-item:hover{ color: var(--text-dim); background: var(--panel-2); }
  .nav-item .nav-dot{
    width: 27px; height: 27px;
    border-radius: 50%;
    background: var(--panel);
    border: 1.5px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .nav-item .nav-label{
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-item.active{ color: var(--text); }
  .nav-item.active .nav-dot{
    background: var(--blue);
    border-color: var(--blue);
    color: var(--ink);
    box-shadow: 0 0 0 4px var(--blue-soft);
  }
  .nav-item.active .nav-label{ color: var(--text); }

  @media (max-width: 980px){
    .layout{ grid-template-columns: 1fr; padding: 20px 16px 60px; }
    .nav-rail{
      position: sticky;
      top: 0;
      z-index: 800;
      flex-direction: row;
      overflow-x: auto;
      background: rgba(55,65,74,0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      padding: 10px 4px;
      margin: -20px -16px 4px;
      gap: 6px;
    }
    .nav-rail-line{ display:none; }
    .nav-item .nav-label{ display:none; }
    .nav-item{ padding: 8px; }
  }

  /* panel entrance animation */
  .panel{
    opacity: 0;
    transform: translateY(14px);
  }
  .panel.in-view{
    animation: panelIn 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  @keyframes panelIn{
    to{ opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>

<div class="progress-bar" id="progressBar"></div>

<header>
  <div class="brand">
    <div class="brand-mark">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="3.2" stroke="#20262B" stroke-width="1.6"/>
        <path d="M4 8.5C4 6 6 4 8.5 4h7C18 4 20 6 20 8.5v7c0 2.5-2 4.5-4.5 4.5h-7C6 20 4 18 4 15.5v-7z" stroke="#20262B" stroke-width="1.6"/>
      </svg>
    </div>
    <div>
      <h1>Grid<span>Watch</span></h1>
      <div class="subtitle">Camera Network &amp; Vehicle Tracking Console</div>
    </div>
  </div>
  <div class="status"><span class="dot"></span> 14 CAMERAS ONLINE · LAST SYNC 2 MIN AGO</div>
</header>

<div class="layout">

  <nav class="nav-rail" id="navRail">
    <div class="nav-rail-line"></div>
    <a class="nav-item" data-target="panel-search">
      <span class="nav-dot">1</span><span class="nav-label">Search</span>
    </a>
    <a class="nav-item" data-target="panel-events">
      <span class="nav-dot">2</span><span class="nav-label">Event log</span>
    </a>
    <a class="nav-item" data-target="panel-map">
      <span class="nav-dot">3</span><span class="nav-label">Map</span>
    </a>
    <a class="nav-item" data-target="panel-watchlist">
      <span class="nav-dot">4</span><span class="nav-label">Watchlist</span>
    </a>
  </nav>

  <main class="content">

  <!-- SEARCH -->
  <section class="panel" id="panel-search">
    <div class="panel-head">
      <div class="panel-head-left">
        <span class="step-num">1</span>
        <h2>Search events</h2>
      </div>
      <span class="hint">Query by camera ID, location, or event type</span>
    </div>
    <div class="panel-body">
      <div class="search-row">
        <input type="text" id="searchInput" placeholder="e.g. CAM-04, loading dock, vehicle...">
        <button id="searchBtn">Search</button>
        <button class="ghost" id="clearBtn">Clear</button>
      </div>
      <div class="search-tags" id="quickTags"></div>

      <div class="divider">
        <label class="field-label">Track vehicle by number</label>
        <div class="search-row">
          <input type="text" id="vehicleInput" class="mono" placeholder="e.g. UP32AB1234">
          <button id="trackBtn">Locate on map</button>
          <button class="ghost" id="clearTrackBtn">Clear tracking</button>
        </div>
        <div id="trackStatus" style="margin-top:10px; font-size:12.5px; color:var(--muted);"></div>
      </div>
    </div>
  </section>

  <!-- EVENT TABLE -->
  <section class="panel" id="panel-events">
    <div class="panel-head">
      <div class="panel-head-left">
        <span class="step-num">2</span>
        <h2>Event log</h2>
      </div>
      <span class="hint" id="resultCount">12 events</span>
    </div>
    <div class="panel-body" style="padding-top:8px; overflow-x:auto;">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Camera</th>
            <th>Location</th>
            <th>Event type</th>
            <th>Vehicle no.</th>
            <th>Confidence</th>
          </tr>
        </thead>
        <tbody id="eventTableBody"></tbody>
      </table>
    </div>
  </section>

  <!-- MAP -->
  <section class="panel" id="panel-map">
    <div class="panel-head">
      <div class="panel-head-left">
        <span class="step-num">3</span>
        <h2>Trajectory &amp; camera map</h2>
      </div>
      <div class="map-controls">
        <button class="ghost" id="toggleHeat">Toggle heatmap</button>
        <button class="ghost" id="toggleRoute">Toggle route</button>
      </div>
    </div>
    <div class="map-wrap">
      <div id="map"></div>
      <div class="legend">
        <div class="legend-item"><span class="legend-swatch" style="background:var(--blue)"></span> Camera</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--gold)"></span> Route stop</div>
        <div class="legend-item"><span class="legend-line" style="background:var(--blue)"></span> Camera trajectory</div>
        <div class="legend-item"><span class="legend-line" style="background:var(--red)"></span> Vehicle route</div>
        <div class="legend-item"><span class="legend-heat"></span> Activity density</div>
      </div>
    </div>
  </section>

  <!-- WATCHLIST -->
  <section class="panel" id="panel-watchlist">
    <div class="panel-head">
      <div class="panel-head-left">
        <span class="step-num">4</span>
        <h2>Watchlist</h2>
      </div>
      <span class="hint" id="wlCount">0 entries</span>
    </div>
    <div class="panel-body watchlist-stack">
      <form class="watchlist-form" id="wlForm">
        <div class="full">
          <label for="wlName">Name / identifier</label>
          <input type="text" id="wlName" required placeholder="e.g. Person A / Plate DL04AB1234">
        </div>
        <div>
          <label for="wlType">Type</label>
          <select id="wlType">
            <option value="Person">Person</option>
            <option value="Vehicle">Vehicle</option>
            <option value="Object">Object</option>
          </select>
        </div>
        <div>
          <label for="wlPriority">Priority</label>
          <select id="wlPriority">
            <option value="high">High</option>
            <option value="med" selected>Medium</option>
            <option value="low">Low</option>
          </select>
        </div>
        <div class="submit-row" style="align-items:flex-end;">
          <button type="submit" style="width:100%;">Add to watchlist</button>
        </div>
        <div class="full">
          <label for="wlNote">Reason / note</label>
          <textarea id="wlNote" rows="2" placeholder="Why is this on the watchlist?"></textarea>
        </div>
      </form>
      <div>
        <div class="wl-list-head">Active entries</div>
        <div id="wlList"></div>
      </div>
    </div>
  </section>

  </main>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script>
/* ---------------------------------------------------------
   MOCK DATA
   In a real deployment, replace fetchEvents() with a call to
   your backend search API, e.g.:
     fetch(`/api/events/search?q=${encodeURIComponent(query)}`)
--------------------------------------------------------- */

const CAMERAS = [
  { id: "CAM-01", name: "Main Gate",        lat: 26.8500, lng: 80.9450 },
  { id: "CAM-02", name: "Parking Lot B",    lat: 26.8520, lng: 80.9480 },
  { id: "CAM-03", name: "Loading Dock",     lat: 26.8545, lng: 80.9510 },
  { id: "CAM-04", name: "Warehouse East",   lat: 26.8560, lng: 80.9470 },
  { id: "CAM-05", name: "Perimeter North",  lat: 26.8580, lng: 80.9440 },
  { id: "CAM-06", name: "Server Room Hall", lat: 26.8500, lng: 80.9400 },
];

const EVENTS = [
  { time: "09:12:04", camera: "CAM-01", location: "Main Gate",        type: "Vehicle entry",     confidence: 0.96, vehicle: "UP32AB1234" },
  { time: "09:14:41", camera: "CAM-02", location: "Parking Lot B",    type: "Vehicle parked",    confidence: 0.91, vehicle: "UP32AB1234" },
  { time: "09:18:07", camera: "CAM-02", location: "Parking Lot B",    type: "Person on foot",    confidence: 0.88, vehicle: null },
  { time: "09:20:52", camera: "CAM-03", location: "Loading Dock",     type: "Person on foot",    confidence: 0.93, vehicle: null },
  { time: "09:21:30", camera: "CAM-03", location: "Loading Dock",     type: "Vehicle entry",     confidence: 0.89, vehicle: "DL04CD5678" },
  { time: "09:22:15", camera: "CAM-03", location: "Loading Dock",     type: "Unattended object", confidence: 0.61, vehicle: null },
  { time: "09:25:39", camera: "CAM-04", location: "Warehouse East",   type: "Door held open",    confidence: 0.78, vehicle: null },
  { time: "09:27:18", camera: "CAM-04", location: "Warehouse East",   type: "Vehicle entry",     confidence: 0.90, vehicle: "UP32AB1234" },
  { time: "09:29:03", camera: "CAM-04", location: "Warehouse East",   type: "Person on foot",    confidence: 0.85, vehicle: null },
  { time: "09:31:47", camera: "CAM-05", location: "Perimeter North",  type: "Loitering",         confidence: 0.72, vehicle: null },
  { time: "09:33:59", camera: "CAM-05", location: "Perimeter North",  type: "Vehicle entry",     confidence: 0.68, vehicle: "DL04CD5678" },
  { time: "09:36:22", camera: "CAM-06", location: "Server Room Hall", type: "Badge access",      confidence: 0.99, vehicle: null },
  { time: "09:40:10", camera: "CAM-01", location: "Main Gate",        type: "Vehicle exit",      confidence: 0.94, vehicle: "UP32AB1234" },
  { time: "09:42:33", camera: "CAM-06", location: "Server Room Hall", type: "After-hours entry", confidence: 0.83, vehicle: null },
];

// Trajectory: ordered sequence of camera hits tracing one path through the site
const TRAJECTORY = ["CAM-01", "CAM-02", "CAM-03", "CAM-04", "CAM-06"]
  .map(id => CAMERAS.find(c => c.id === id));

// Heatmap sample points [lat, lng, intensity]
const HEAT_POINTS = [
  [26.8500, 80.9450, 0.6], [26.8503, 80.9455, 0.5],
  [26.8520, 80.9480, 0.9], [26.8523, 80.9483, 0.7],
  [26.8545, 80.9510, 1.0], [26.8548, 80.9505, 0.8], [26.8542, 80.9515, 0.6],
  [26.8560, 80.9470, 0.4],
  [26.8580, 80.9440, 0.3], [26.8578, 80.9445, 0.3],
  [26.8500, 80.9400, 0.5],
];

function confBadge(c){
  const cls = c >= 0.85 ? "high" : c >= 0.65 ? "med" : "low";
  return `<span class="badge ${cls}">${(c*100).toFixed(0)}%</span>`;
}

/* Simulated search "API" call */
function fetchEvents(query){
  return new Promise(resolve => {
    setTimeout(() => {
      const q = query.trim().toLowerCase();
      if(!q){ resolve(EVENTS); return; }
      resolve(EVENTS.filter(e =>
        e.camera.toLowerCase().includes(q) ||
        e.location.toLowerCase().includes(q) ||
        e.type.toLowerCase().includes(q) ||
        (e.vehicle && e.vehicle.toLowerCase().includes(q))
      ));
    }, 250); // simulated network latency
  });
}

function renderEvents(list){
  const body = document.getElementById("eventTableBody");
  document.getElementById("resultCount").textContent = `${list.length} event${list.length===1?"":"s"}`;
  if(list.length === 0){
    body.innerHTML = `<tr class="empty-row"><td colspan="6">No events match that search.</td></tr>`;
    return;
  }
  body.innerHTML = list.map(e => `
    <tr>
      <td class="mono">${e.time}</td>
      <td class="mono">${e.camera}</td>
      <td>${e.location}</td>
      <td>${e.type}</td>
      <td class="mono">${e.vehicle ? e.vehicle : '<span style="color:var(--muted)">—</span>'}</td>
      <td>${confBadge(e.confidence)}</td>
    </tr>
  `).join("");
}

async function runSearch(query){
  const results = await fetchEvents(query);
  renderEvents(results);
}

document.getElementById("searchBtn").addEventListener("click", () => {
  runSearch(document.getElementById("searchInput").value);
});
document.getElementById("searchInput").addEventListener("keydown", (e) => {
  if(e.key === "Enter") runSearch(e.target.value);
});
document.getElementById("clearBtn").addEventListener("click", () => {
  document.getElementById("searchInput").value = "";
  runSearch("");
});

const quickTags = ["CAM-03", "Loading Dock", "Loitering", "After-hours entry"];
document.getElementById("quickTags").innerHTML = quickTags.map(t =>
  `<span class="tag" data-q="${t}">${t}</span>`
).join("");
document.querySelectorAll(".tag").forEach(tag => {
  tag.addEventListener("click", () => {
    document.getElementById("searchInput").value = tag.dataset.q;
    runSearch(tag.dataset.q);
  });
});

/* ---------------- MAP ---------------- */
const map = L.map('map', { zoomControl: true }).setView([26.8535, 80.9465], 15);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '&copy; OpenStreetMap contributors',
  maxZoom: 19
}).addTo(map);

// force dashboard-friendly muted tile look
document.getElementById("map").style.filter = "grayscale(0.3) brightness(0.95) contrast(1.02)";

// Camera markers
const cameraIcon = L.divIcon({
  className: '',
  html: `<div style="width:14px;height:14px;border-radius:50%;background:#4FB0A5;border:2px solid #20262B;box-shadow:0 0 0 3px rgba(79,176,165,0.3);"></div>`,
  iconSize: [14,14],
  iconAnchor: [7,7]
});

CAMERAS.forEach(cam => {
  L.marker([cam.lat, cam.lng], { icon: cameraIcon })
    .addTo(map)
    .bindPopup(`<b>${cam.id}</b><br>${cam.name}`);
});

// Trajectory line connecting cameras in visit order
const routeLatLngs = TRAJECTORY.map(c => [c.lat, c.lng]);
let routeLine = L.polyline(routeLatLngs, {
  color: '#4FB0A5',
  weight: 3,
  opacity: 0.85,
  dashArray: '1,8',
  lineCap: 'round'
}).addTo(map);

// Small direction markers along the route
TRAJECTORY.forEach((cam, i) => {
  if(i === 0) return;
  L.circleMarker([cam.lat, cam.lng], {
    radius: 5, color: '#C97B4A', fillColor:'#C97B4A', fillOpacity: 1, weight: 1
  }).addTo(map).bindTooltip(`Stop ${i+1}: ${cam.id}`, { direction: 'top' });
});

// Heatmap overlay
let heatLayer = L.heatLayer(HEAT_POINTS, {
  radius: 32,
  blur: 24,
  maxZoom: 17,
  gradient: { 0.3: '#3A5B62', 0.5: '#4FB0A5', 0.75: '#C97B4A', 1: '#D9695C' }
}).addTo(map);

// Vehicle tracking layer (separate from the general trajectory route)
let vehicleRouteLine = null;
let vehicleMarkers = [];
let routeLineOn = true; // general trajectory route starts visible

function clearVehicleTracking(){
  if(vehicleRouteLine){ map.removeLayer(vehicleRouteLine); vehicleRouteLine = null; }
  vehicleMarkers.forEach(m => map.removeLayer(m));
  vehicleMarkers = [];
  document.getElementById("trackStatus").textContent = "";
  document.querySelectorAll("#eventTableBody tr").forEach(tr => tr.style.background = "");
}

function trackVehicle(plateRaw){
  const plate = plateRaw.trim().toUpperCase();
  if(!plate) return;

  clearVehicleTracking();

  const hits = EVENTS
    .filter(e => e.vehicle && e.vehicle.toUpperCase() === plate)
    .sort((a,b) => a.time.localeCompare(b.time));

  if(hits.length === 0){
    document.getElementById("trackStatus").innerHTML =
      `<span style="color:var(--red)">No detections found for "${plate}".</span>`;
    renderEvents(EVENTS.filter(() => false)); // show empty state via normal search too
    runSearch(plate);
    return;
  }

  // build path from the cameras that detected this vehicle, in time order
  const path = hits.map(h => {
    const cam = CAMERAS.find(c => c.id === h.camera);
    return { ...h, lat: cam.lat, lng: cam.lng, camName: cam.name };
  });

  // draw the vehicle's route and turn the route display "on"
  vehicleRouteLine = L.polyline(path.map(p => [p.lat, p.lng]), {
    color: '#D9695C',
    weight: 4,
    opacity: 0.9,
    lineCap: 'round'
  }).addTo(map);
  routeLineOn = true;

  const vehicleIcon = L.divIcon({
    className: '',
    html: `<div style="width:16px;height:16px;border-radius:50%;background:#D9695C;border:2px solid #20262B;box-shadow:0 0 0 4px rgba(217,105,92,0.3);"></div>`,
    iconSize: [16,16], iconAnchor: [8,8]
  });

  path.forEach((p, i) => {
    const marker = L.marker([p.lat, p.lng], { icon: vehicleIcon })
      .addTo(map)
      .bindPopup(`<b>${plate}</b><br>${p.camName} (${p.camera})<br>${p.time} — ${p.type}`);
    if(i === path.length - 1) marker.openPopup(); // latest known location
    vehicleMarkers.push(marker);
  });

  // pan/zoom the map to the vehicle's full tracked path
  map.fitBounds(vehicleRouteLine.getBounds(), { padding: [40,40] });

  const last = path[path.length - 1];
  document.getElementById("trackStatus").innerHTML =
    `<span style="color:var(--blue); font-weight:700;">${plate}</span> — ${hits.length} detection${hits.length===1?"":"s"} · last seen <span class="mono">${last.camName} (${last.camera})</span> at <span class="mono">${last.time}</span>`;

  // filter the event log to this vehicle's detections
  document.getElementById("searchInput").value = plate;
  runSearch(plate);
}

document.getElementById("trackBtn").addEventListener("click", () => {
  trackVehicle(document.getElementById("vehicleInput").value);
});
document.getElementById("vehicleInput").addEventListener("keydown", (e) => {
  if(e.key === "Enter") trackVehicle(e.target.value);
});
document.getElementById("clearTrackBtn").addEventListener("click", () => {
  document.getElementById("vehicleInput").value = "";
  clearVehicleTracking();
  document.getElementById("searchInput").value = "";
  runSearch("");
});

document.getElementById("toggleHeat").addEventListener("click", () => {
  if(map.hasLayer(heatLayer)) map.removeLayer(heatLayer); else heatLayer.addTo(map);
});
document.getElementById("toggleRoute").addEventListener("click", () => {
  if(map.hasLayer(routeLine)) map.removeLayer(routeLine); else routeLine.addTo(map);
});

/* ---------------- WATCHLIST ---------------- */
let watchlist = [];

function renderWatchlist(){
  const list = document.getElementById("wlList");
  document.getElementById("wlCount").textContent = `${watchlist.length} entr${watchlist.length===1?"y":"ies"}`;
  if(watchlist.length === 0){
    list.innerHTML = `<div style="color:var(--muted); font-size:13px; padding: 4px 0;">No one on the watchlist yet. Add an entry using the form.</div>`;
    return;
  }
  const pClass = { high: 'high', med: 'med', low: 'low' };
  const pLabel = { high: 'HIGH', med: 'MEDIUM', low: 'LOW' };
  list.innerHTML = watchlist.map((w, idx) => `
    <div class="wl-item">
      <div>
        <div class="name">${w.name} <span class="priority badge ${pClass[w.priority]}">${pLabel[w.priority]}</span></div>
        <div class="meta">${w.type}${w.note ? " · " + w.note : ""}</div>
      </div>
      <button data-idx="${idx}" class="wlRemove">Remove</button>
    </div>
  `).join("");
  document.querySelectorAll(".wlRemove").forEach(btn => {
    btn.addEventListener("click", () => {
      watchlist.splice(Number(btn.dataset.idx), 1);
      renderWatchlist();
    });
  });
}

document.getElementById("wlForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const name = document.getElementById("wlName").value.trim();
  if(!name) return;
  watchlist.push({
    name,
    type: document.getElementById("wlType").value,
    priority: document.getElementById("wlPriority").value,
    note: document.getElementById("wlNote").value.trim()
  });
  e.target.reset();
  document.getElementById("wlPriority").value = "med";
  renderWatchlist();
});

/* init */
runSearch("");
renderWatchlist();

/* ---------------- NAV RAIL: scrollspy + smooth scroll ---------------- */
const navItems = document.querySelectorAll(".nav-item");
const trackedPanels = ["panel-search", "panel-events", "panel-map", "panel-watchlist"]
  .map(id => document.getElementById(id));

navItems.forEach(item => {
  item.addEventListener("click", () => {
    const target = document.getElementById(item.dataset.target);
    if(target){
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
});

function setActiveNav(id){
  navItems.forEach(item => {
    item.classList.toggle("active", item.dataset.target === id);
  });
}

const spyObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if(entry.isIntersecting){
      setActiveNav(entry.target.id);
    }
  });
}, { rootMargin: "-15% 0px -70% 0px", threshold: 0 });

trackedPanels.forEach(panel => { if(panel) spyObserver.observe(panel); });
setActiveNav("panel-search"); // default on load

/* ---------------- PANEL ENTRANCE ANIMATION ---------------- */
const revealObserver = new IntersectionObserver((entries, obs) => {
  entries.forEach((entry, i) => {
    if(entry.isIntersecting){
      entry.target.style.animationDelay = `${i * 0.05}s`;
      entry.target.classList.add("in-view");
      obs.unobserve(entry.target);
    }
  });
}, { threshold: 0.08 });

document.querySelectorAll(".panel").forEach(panel => revealObserver.observe(panel));

/* ---------------- SCROLL PROGRESS BAR ---------------- */
const progressBar = document.getElementById("progressBar");
function updateProgress(){
  const scrollTop = window.scrollY;
  const docHeight = document.documentElement.scrollHeight - window.innerHeight;
  const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
  progressBar.style.width = pct + "%";
}
window.addEventListener("scroll", updateProgress, { passive: true });
updateProgress();
</script>
</body>
</html>
