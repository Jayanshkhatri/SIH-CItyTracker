<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grid Watch — Camera Network Monitor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  :root{
    --bg: #0A1620;
    --panel: #0F202B;
    --panel-2: #142B38;
    --line: #1E3A48;
    --text: #DCE8ED;
    --muted: #6E8FA0;
    --amber: #E8A33D;
    --cyan: #3FC7D6;
    --red: #E2584B;
    --green: #4FBF83;
  }
  *{ box-sizing: border-box; }
  body{
    margin:0;
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }
  .mono{ font-family: 'IBM Plex Mono', monospace; }

  header{
    padding: 22px 28px 18px;
    border-bottom: 1px solid var(--line);
    display:flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  header h1{
    margin:0;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  header h1 span{ color: var(--amber); }
  header .status{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    display:flex;
    align-items:center;
    gap: 8px;
  }
  .dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(79,191,131,0.15);
  }

  main{
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 28px 60px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .panel{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .panel-head{
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content: space-between;
  }
  .panel-head h2{
    margin:0;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .panel-head .hint{
    font-size: 11.5px;
    color: var(--muted);
  }
  .panel-body{ padding: 18px; }

  /* Search */
  .search-row{
    display:flex;
    gap: 10px;
  }
  input[type="text"], select, textarea{
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 3px;
    padding: 9px 11px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13.5px;
    outline: none;
  }
  input[type="text"]:focus, select:focus, textarea:focus{
    border-color: var(--cyan);
  }
  .search-row input{ flex:1; }
  button{
    background: var(--amber);
    color: #201404;
    border: none;
    border-radius: 3px;
    padding: 9px 18px;
    font-weight: 600;
    font-size: 13.5px;
    cursor: pointer;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  button:hover{ filter: brightness(1.08); }
  button.ghost{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text);
  }
  .search-tags{
    margin-top: 10px;
    display:flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 3px 9px;
    border-radius: 20px;
    cursor: pointer;
  }
  .tag:hover{ color: var(--cyan); border-color: var(--cyan); }

  /* Table */
  table{ width:100%; border-collapse: collapse; }
  thead th{
    text-align:left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    padding: 0 12px 10px;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }
  tbody td{
    padding: 10px 12px;
    border-bottom: 1px solid rgba(30,58,72,0.5);
    font-size: 13px;
    vertical-align: middle;
  }
  tbody tr:hover{ background: rgba(63,199,214,0.05); }
  .badge{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 3px;
    display:inline-block;
  }
  .badge.high{ background: rgba(226,88,75,0.15); color: var(--red); }
  .badge.med{ background: rgba(232,163,61,0.15); color: var(--amber); }
  .badge.low{ background: rgba(79,191,131,0.15); color: var(--green); }
  .empty-row td{
    color: var(--muted);
    text-align:center;
    padding: 26px 12px;
    font-size: 13px;
  }

  /* map + legend */
  .map-wrap{ position: relative; }
  #map{ height: 420px; width: 100%; border-radius: 0 0 4px 4px; }
  .legend{
    position:absolute;
    bottom: 14px;
    left: 14px;
    z-index: 500;
    background: rgba(10,22,32,0.9);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 11.5px;
    color: var(--muted);
    display:flex;
    flex-direction: column;
    gap: 6px;
  }
  .legend-item{ display:flex; align-items:center; gap: 8px; }
  .legend-swatch{ width:12px; height:12px; border-radius: 50%; }
  .legend-line{ width:16px; height:2px; }
  .legend-heat{
    width:16px; height:12px;
    background: linear-gradient(90deg, #2e6b8a, #3fc7d6, #e8a33d, #e2584b);
    border-radius: 2px;
  }
  .map-controls{
    display:flex; gap: 8px;
  }

  /* watchlist */
  .watchlist-grid{
    display:grid;
    grid-template-columns: 340px 1fr;
    gap: 24px;
  }
  form.watchlist-form{
    display:flex;
    flex-direction: column;
    gap: 10px;
  }
  form.watchlist-form label{
    font-size: 11.5px;
    color: var(--muted);
    display:block;
    margin-bottom: 4px;
  }
  .wl-item{
    display:flex;
    justify-content: space-between;
    align-items:center;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 3px;
    margin-bottom: 8px;
  }
  .wl-item .name{ font-weight: 600; font-size: 13.5px; }
  .wl-item .meta{ font-size: 11.5px; color: var(--muted); font-family: 'IBM Plex Mono', monospace; margin-top: 2px; }
  .wl-item button{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--red);
    padding: 5px 10px;
    font-size: 11.5px;
  }
  .priority{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    padding: 2px 7px;
    border-radius: 3px;
  }

  @media (max-width: 820px){
    .watchlist-grid{ grid-template-columns: 1fr; }
    header{ flex-direction: column; align-items:flex-start; }
  }
</style>
</head>
<body>

<header>
  <h1>Grid<span>Watch</span> — Camera Network Monitor</h1>
  <div class="status"><span class="dot"></span> 14 CAMERAS ONLINE · LAST SYNC 2 MIN AGO</div>
</header>

<main>

  <!-- SEARCH -->
  <section class="panel">
    <div class="panel-head">
      <h2>Search events</h2>
      <span class="hint">Query by camera ID, location, or event type</span>
    </div>
    <div class="panel-body">
      <div class="search-row">
        <input type="text" id="searchInput" placeholder="e.g. CAM-04, loading dock, vehicle...">
        <button id="searchBtn">Search</button>
        <button class="ghost" id="clearBtn">Clear</button>
      </div>
      <div class="search-tags" id="quickTags"></div>

      <div style="margin-top:16px; padding-top:16px; border-top:1px solid var(--line);">
        <label style="font-size:11.5px; color:var(--muted); display:block; margin-bottom:6px;">Track vehicle by number</label>
        <div class="search-row">
          <input type="text" id="vehicleInput" class="mono" placeholder="e.g. UP32AB1234">
          <button id="trackBtn">Locate on map</button>
          <button class="ghost" id="clearTrackBtn">Clear tracking</button>
        </div>
        <div id="trackStatus" style="margin-top:8px; font-size:12px; color:var(--muted);"></div>
      </div>
    </div>
  </section>

  <!-- EVENT TABLE -->
  <section class="panel">
    <div class="panel-head">
      <h2>Event log</h2>
      <span class="hint" id="resultCount">12 events</span>
    </div>
    <div class="panel-body" style="padding-top:6px; overflow-x:auto;">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Camera</th>
            <th>Location</th>
            <th>Event type</th>
            <th>Vehicle no.</th>
            <th>Confidence</th>
          </tr>
        </thead>
        <tbody id="eventTableBody"></tbody>
      </table>
    </div>
  </section>

  <!-- MAP -->
  <section class="panel">
    <div class="panel-head">
      <h2>Trajectory &amp; camera map</h2>
      <div class="map-controls">
        <button class="ghost" id="toggleHeat">Toggle heatmap</button>
        <button class="ghost" id="toggleRoute">Toggle route</button>
      </div>
    </div>
    <div class="map-wrap">
      <div id="map"></div>
      <div class="legend">
        <div class="legend-item"><span class="legend-swatch" style="background:var(--cyan)"></span> Camera</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--amber)"></span> Selected event</div>
        <div class="legend-item"><span class="legend-line" style="background:var(--cyan)"></span> Camera trajectory</div>
        <div class="legend-item"><span class="legend-line" style="background:var(--red)"></span> Vehicle route</div>
        <div class="legend-item"><span class="legend-heat"></span> Activity density</div>
      </div>
    </div>
  </section>

  <!-- WATCHLIST -->
  <section class="panel">
    <div class="panel-head">
      <h2>Watchlist</h2>
      <span class="hint" id="wlCount">0 entries</span>
    </div>
    <div class="panel-body watchlist-grid">
      <form class="watchlist-form" id="wlForm">
        <div>
          <label for="wlName">Name / identifier</label>
          <input type="text" id="wlName" required placeholder="e.g. Person A / Plate DL04AB1234">
        </div>
        <div>
          <label for="wlType">Type</label>
          <select id="wlType">
            <option value="Person">Person</option>
            <option value="Vehicle">Vehicle</option>
            <option value="Object">Object</option>
          </select>
        </div>
        <div>
          <label for="wlPriority">Priority</label>
          <select id="wlPriority">
            <option value="high">High</option>
            <option value="med" selected>Medium</option>
            <option value="low">Low</option>
          </select>
        </div>
        <div>
          <label for="wlNote">Reason / note</label>
          <textarea id="wlNote" rows="2" placeholder="Why is this on the watchlist?"></textarea>
        </div>
        <button type="submit">Add to watchlist</button>
      </form>
      <div id="wlList"></div>
    </div>
  </section>

</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script>
/* ---------------------------------------------------------
   MOCK DATA
   In a real deployment, replace fetchEvents() with a call to
   your backend search API, e.g.:
     fetch(`/api/events/search?q=${encodeURIComponent(query)}`)
--------------------------------------------------------- */

const CAMERAS = [
  { id: "CAM-01", name: "Main Gate",        lat: 26.8500, lng: 80.9450 },
  { id: "CAM-02", name: "Parking Lot B",    lat: 26.8520, lng: 80.9480 },
  { id: "CAM-03", name: "Loading Dock",     lat: 26.8545, lng: 80.9510 },
  { id: "CAM-04", name: "Warehouse East",   lat: 26.8560, lng: 80.9470 },
  { id: "CAM-05", name: "Perimeter North",  lat: 26.8580, lng: 80.9440 },
  { id: "CAM-06", name: "Server Room Hall", lat: 26.8500, lng: 80.9400 },
];

const EVENTS = [
  { time: "09:12:04", camera: "CAM-01", location: "Main Gate",        type: "Vehicle entry",     confidence: 0.96, vehicle: "UP32AB1234" },
  { time: "09:14:41", camera: "CAM-02", location: "Parking Lot B",    type: "Vehicle parked",    confidence: 0.91, vehicle: "UP32AB1234" },
  { time: "09:18:07", camera: "CAM-02", location: "Parking Lot B",    type: "Person on foot",    confidence: 0.88, vehicle: null },
  { time: "09:20:52", camera: "CAM-03", location: "Loading Dock",     type: "Person on foot",    confidence: 0.93, vehicle: null },
  { time: "09:21:30", camera: "CAM-03", location: "Loading Dock",     type: "Vehicle entry",     confidence: 0.89, vehicle: "DL04CD5678" },
  { time: "09:22:15", camera: "CAM-03", location: "Loading Dock",     type: "Unattended object", confidence: 0.61, vehicle: null },
  { time: "09:25:39", camera: "CAM-04", location: "Warehouse East",   type: "Door held open",    confidence: 0.78, vehicle: null },
  { time: "09:27:18", camera: "CAM-04", location: "Warehouse East",   type: "Vehicle entry",     confidence: 0.90, vehicle: "UP32AB1234" },
  { time: "09:29:03", camera: "CAM-04", location: "Warehouse East",   type: "Person on foot",    confidence: 0.85, vehicle: null },
  { time: "09:31:47", camera: "CAM-05", location: "Perimeter North",  type: "Loitering",         confidence: 0.72, vehicle: null },
  { time: "09:33:59", camera: "CAM-05", location: "Perimeter North",  type: "Vehicle entry",     confidence: 0.68, vehicle: "DL04CD5678" },
  { time: "09:36:22", camera: "CAM-06", location: "Server Room Hall", type: "Badge access",      confidence: 0.99, vehicle: null },
  { time: "09:40:10", camera: "CAM-01", location: "Main Gate",        type: "Vehicle exit",      confidence: 0.94, vehicle: "UP32AB1234" },
  { time: "09:42:33", camera: "CAM-06", location: "Server Room Hall", type: "After-hours entry", confidence: 0.83, vehicle: null },
];

// Trajectory: ordered sequence of camera hits tracing one path through the site
const TRAJECTORY = ["CAM-01", "CAM-02", "CAM-03", "CAM-04", "CAM-06"]
  .map(id => CAMERAS.find(c => c.id === id));

// Heatmap sample points [lat, lng, intensity]
const HEAT_POINTS = [
  [26.8500, 80.9450, 0.6], [26.8503, 80.9455, 0.5],
  [26.8520, 80.9480, 0.9], [26.8523, 80.9483, 0.7],
  [26.8545, 80.9510, 1.0], [26.8548, 80.9505, 0.8], [26.8542, 80.9515, 0.6],
  [26.8560, 80.9470, 0.4],
  [26.8580, 80.9440, 0.3], [26.8578, 80.9445, 0.3],
  [26.8500, 80.9400, 0.5],
];

function confBadge(c){
  const cls = c >= 0.85 ? "high" : c >= 0.65 ? "med" : "low";
  return `<span class="badge ${cls}">${(c*100).toFixed(0)}%</span>`;
}

/* Simulated search "API" call */
function fetchEvents(query){
  return new Promise(resolve => {
    setTimeout(() => {
      const q = query.trim().toLowerCase();
      if(!q){ resolve(EVENTS); return; }
      resolve(EVENTS.filter(e =>
        e.camera.toLowerCase().includes(q) ||
        e.location.toLowerCase().includes(q) ||
        e.type.toLowerCase().includes(q) ||
        (e.vehicle && e.vehicle.toLowerCase().includes(q))
      ));
    }, 250); // simulated network latency
  });
}

function renderEvents(list){
  const body = document.getElementById("eventTableBody");
  document.getElementById("resultCount").textContent = `${list.length} event${list.length===1?"":"s"}`;
  if(list.length === 0){
    body.innerHTML = `<tr class="empty-row"><td colspan="6">No events match that search.</td></tr>`;
    return;
  }
  body.innerHTML = list.map(e => `
    <tr>
      <td class="mono">${e.time}</td>
      <td class="mono">${e.camera}</td>
      <td>${e.location}</td>
      <td>${e.type}</td>
      <td class="mono">${e.vehicle ? e.vehicle : '<span style="color:var(--muted)">—</span>'}</td>
      <td>${confBadge(e.confidence)}</td>
    </tr>
  `).join("");
}

async function runSearch(query){
  const results = await fetchEvents(query);
  renderEvents(results);
}

document.getElementById("searchBtn").addEventListener("click", () => {
  runSearch(document.getElementById("searchInput").value);
});
document.getElementById("searchInput").addEventListener("keydown", (e) => {
  if(e.key === "Enter") runSearch(e.target.value);
});
document.getElementById("clearBtn").addEventListener("click", () => {
  document.getElementById("searchInput").value = "";
  runSearch("");
});

const quickTags = ["CAM-03", "Loading Dock", "Loitering", "After-hours entry"];
document.getElementById("quickTags").innerHTML = quickTags.map(t =>
  `<span class="tag" data-q="${t}">${t}</span>`
).join("");
document.querySelectorAll(".tag").forEach(tag => {
  tag.addEventListener("click", () => {
    document.getElementById("searchInput").value = tag.dataset.q;
    runSearch(tag.dataset.q);
  });
});

/* ---------------- MAP ---------------- */
const map = L.map('map', { zoomControl: true }).setView([26.8535, 80.9465], 15);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '&copy; OpenStreetMap contributors',
  maxZoom: 19
}).addTo(map);

// force dashboard-friendly muted tile look
document.getElementById("map").style.filter = "grayscale(0.35) brightness(0.85) contrast(1.05)";

// Camera markers
const cameraIcon = L.divIcon({
  className: '',
  html: `<div style="width:14px;height:14px;border-radius:50%;background:#3FC7D6;border:2px solid #0A1620;box-shadow:0 0 0 3px rgba(63,199,214,0.25);"></div>`,
  iconSize: [14,14],
  iconAnchor: [7,7]
});

CAMERAS.forEach(cam => {
  L.marker([cam.lat, cam.lng], { icon: cameraIcon })
    .addTo(map)
    .bindPopup(`<b>${cam.id}</b><br>${cam.name}`);
});

// Trajectory line connecting cameras in visit order
const routeLatLngs = TRAJECTORY.map(c => [c.lat, c.lng]);
let routeLine = L.polyline(routeLatLngs, {
  color: '#3FC7D6',
  weight: 3,
  opacity: 0.85,
  dashArray: '1,8',
  lineCap: 'round'
}).addTo(map);

// Small direction markers along the route
TRAJECTORY.forEach((cam, i) => {
  if(i === 0) return;
  L.circleMarker([cam.lat, cam.lng], {
    radius: 5, color: '#E8A33D', fillColor:'#E8A33D', fillOpacity: 1, weight: 1
  }).addTo(map).bindTooltip(`Stop ${i+1}: ${cam.id}`, { direction: 'top' });
});

// Heatmap overlay
let heatLayer = L.heatLayer(HEAT_POINTS, {
  radius: 32,
  blur: 24,
  maxZoom: 17,
  gradient: { 0.3: '#2e6b8a', 0.5: '#3fc7d6', 0.75: '#e8a33d', 1: '#e2584b' }
}).addTo(map);

// Vehicle tracking layer (separate from the general trajectory route)
let vehicleRouteLine = null;
let vehicleMarkers = [];
let routeLineOn = true; // general trajectory route starts visible

function clearVehicleTracking(){
  if(vehicleRouteLine){ map.removeLayer(vehicleRouteLine); vehicleRouteLine = null; }
  vehicleMarkers.forEach(m => map.removeLayer(m));
  vehicleMarkers = [];
  document.getElementById("trackStatus").textContent = "";
  document.querySelectorAll("#eventTableBody tr").forEach(tr => tr.style.background = "");
}

function trackVehicle(plateRaw){
  const plate = plateRaw.trim().toUpperCase();
  if(!plate) return;

  clearVehicleTracking();

  const hits = EVENTS
    .filter(e => e.vehicle && e.vehicle.toUpperCase() === plate)
    .sort((a,b) => a.time.localeCompare(b.time));

  if(hits.length === 0){
    document.getElementById("trackStatus").innerHTML =
      `<span style="color:var(--red)">No detections found for "${plate}".</span>`;
    renderEvents(EVENTS.filter(() => false)); // show empty state via normal search too
    runSearch(plate);
    return;
  }

  // build path from the cameras that detected this vehicle, in time order
  const path = hits.map(h => {
    const cam = CAMERAS.find(c => c.id === h.camera);
    return { ...h, lat: cam.lat, lng: cam.lng, camName: cam.name };
  });

  // draw the vehicle's route and turn the route display "on"
  vehicleRouteLine = L.polyline(path.map(p => [p.lat, p.lng]), {
    color: '#E2584B',
    weight: 4,
    opacity: 0.9,
    lineCap: 'round'
  }).addTo(map);
  routeLineOn = true;

  const vehicleIcon = L.divIcon({
    className: '',
    html: `<div style="width:16px;height:16px;border-radius:50%;background:#E2584B;border:2px solid #0A1620;box-shadow:0 0 0 4px rgba(226,88,75,0.25);"></div>`,
    iconSize: [16,16], iconAnchor: [8,8]
  });

  path.forEach((p, i) => {
    const marker = L.marker([p.lat, p.lng], { icon: vehicleIcon })
      .addTo(map)
      .bindPopup(`<b>${plate}</b><br>${p.camName} (${p.camera})<br>${p.time} — ${p.type}`);
    if(i === path.length - 1) marker.openPopup(); // latest known location
    vehicleMarkers.push(marker);
  });

  // pan/zoom the map to the vehicle's full tracked path
  map.fitBounds(vehicleRouteLine.getBounds(), { padding: [40,40] });

  const last = path[path.length - 1];
  document.getElementById("trackStatus").innerHTML =
    `<span style="color:var(--cyan)">${plate}</span> — ${hits.length} detection${hits.length===1?"":"s"} · last seen <span class="mono">${last.camName} (${last.camera})</span> at <span class="mono">${last.time}</span>`;

  // filter the event log to this vehicle's detections
  document.getElementById("searchInput").value = plate;
  runSearch(plate);
}

document.getElementById("trackBtn").addEventListener("click", () => {
  trackVehicle(document.getElementById("vehicleInput").value);
});
document.getElementById("vehicleInput").addEventListener("keydown", (e) => {
  if(e.key === "Enter") trackVehicle(e.target.value);
});
document.getElementById("clearTrackBtn").addEventListener("click", () => {
  document.getElementById("vehicleInput").value = "";
  clearVehicleTracking();
  document.getElementById("searchInput").value = "";
  runSearch("");
});

document.getElementById("toggleHeat").addEventListener("click", () => {
  if(map.hasLayer(heatLayer)) map.removeLayer(heatLayer); else heatLayer.addTo(map);
});
document.getElementById("toggleRoute").addEventListener("click", () => {
  if(map.hasLayer(routeLine)) map.removeLayer(routeLine); else routeLine.addTo(map);
});

/* ---------------- WATCHLIST ---------------- */
let watchlist = [];

function renderWatchlist(){
  const list = document.getElementById("wlList");
  document.getElementById("wlCount").textContent = `${watchlist.length} entr${watchlist.length===1?"y":"ies"}`;
  if(watchlist.length === 0){
    list.innerHTML = `<div style="color:var(--muted); font-size:13px; padding: 4px 0;">No one on the watchlist yet. Add an entry using the form.</div>`;
    return;
  }
  const pClass = { high: 'high', med: 'med', low: 'low' };
  const pLabel = { high: 'HIGH', med: 'MEDIUM', low: 'LOW' };
  list.innerHTML = watchlist.map((w, idx) => `
    <div class="wl-item">
      <div>
        <div class="name">${w.name} <span class="priority badge ${pClass[w.priority]}">${pLabel[w.priority]}</span></div>
        <div class="meta">${w.type}${w.note ? " · " + w.note : ""}</div>
      </div>
      <button data-idx="${idx}" class="wlRemove">Remove</button>
    </div>
  `).join("");
  document.querySelectorAll(".wlRemove").forEach(btn => {
    btn.addEventListener("click", () => {
      watchlist.splice(Number(btn.dataset.idx), 1);
      renderWatchlist();
    });
  });
}

document.getElementById("wlForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const name = document.getElementById("wlName").value.trim();
  if(!name) return;
  watchlist.push({
    name,
    type: document.getElementById("wlType").value,
    priority: document.getElementById("wlPriority").value,
    note: document.getElementById("wlNote").value.trim()
  });
  e.target.reset();
  document.getElementById("wlPriority").value = "med";
  renderWatchlist();
});

/* init */
runSearch("");
renderWatchlist();
</script>
