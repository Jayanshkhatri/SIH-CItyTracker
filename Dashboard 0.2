<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script>
/* ---------------------------------------------------------
   MOCK DATA
   In a real deployment, replace fetchEvents() with a call to
   your backend search API, e.g.:
     fetch(`/api/events/search?q=${encodeURIComponent(query)}`)
--------------------------------------------------------- */

const CAMERAS = [
  { id: "CAM-01", name: "Main Gate",        lat: 26.8500, lng: 80.9450 },
  { id: "CAM-02", name: "Parking Lot B",    lat: 26.8520, lng: 80.9480 },
  { id: "CAM-03", name: "Loading Dock",     lat: 26.8545, lng: 80.9510 },
  { id: "CAM-04", name: "Warehouse East",   lat: 26.8560, lng: 80.9470 },
  { id: "CAM-05", name: "Perimeter North",  lat: 26.8580, lng: 80.9440 },
  { id: "CAM-06", name: "Server Room Hall", lat: 26.8500, lng: 80.9400 },
];

const EVENTS = [
  { time: "09:12:04", camera: "CAM-01", location: "Main Gate",        type: "Vehicle entry",     confidence: 0.96, vehicle: "UP32AB1234" },
  { time: "09:14:41", camera: "CAM-02", location: "Parking Lot B",    type: "Vehicle parked",    confidence: 0.91, vehicle: "UP32AB1234" },
  { time: "09:18:07", camera: "CAM-02", location: "Parking Lot B",    type: "Person on foot",    confidence: 0.88, vehicle: null },
  { time: "09:20:52", camera: "CAM-03", location: "Loading Dock",     type: "Person on foot",    confidence: 0.93, vehicle: null },
  { time: "09:21:30", camera: "CAM-03", location: "Loading Dock",     type: "Vehicle entry",     confidence: 0.89, vehicle: "DL04CD5678" },
  { time: "09:22:15", camera: "CAM-03", location: "Loading Dock",     type: "Unattended object", confidence: 0.61, vehicle: null },
  { time: "09:25:39", camera: "CAM-04", location: "Warehouse East",   type: "Door held open",    confidence: 0.78, vehicle: null },
  { time: "09:27:18", camera: "CAM-04", location: "Warehouse East",   type: "Vehicle entry",     confidence: 0.90, vehicle: "UP32AB1234" },
  { time: "09:29:03", camera: "CAM-04", location: "Warehouse East",   type: "Person on foot",    confidence: 0.85, vehicle: null },
  { time: "09:31:47", camera: "CAM-05", location: "Perimeter North",  type: "Loitering",         confidence: 0.72, vehicle: null },
  { time: "09:33:59", camera: "CAM-05", location: "Perimeter North",  type: "Vehicle entry",     confidence: 0.68, vehicle: "DL04CD5678" },
  { time: "09:36:22", camera: "CAM-06", location: "Server Room Hall", type: "Badge access",      confidence: 0.99, vehicle: null },
  { time: "09:40:10", camera: "CAM-01", location: "Main Gate",        type: "Vehicle exit",      confidence: 0.94, vehicle: "UP32AB1234" },
  { time: "09:42:33", camera: "CAM-06", location: "Server Room Hall", type: "After-hours entry", confidence: 0.83, vehicle: null },
];

// Trajectory: ordered sequence of camera hits tracing one path through the site
const TRAJECTORY = ["CAM-01", "CAM-02", "CAM-03", "CAM-04", "CAM-06"]
  .map(id => CAMERAS.find(c => c.id === id));

// Heatmap sample points [lat, lng, intensity]
const HEAT_POINTS = [
  [26.8500, 80.9450, 0.6], [26.8503, 80.9455, 0.5],
  [26.8520, 80.9480, 0.9], [26.8523, 80.9483, 0.7],
  [26.8545, 80.9510, 1.0], [26.8548, 80.9505, 0.8], [26.8542, 80.9515, 0.6],
  [26.8560, 80.9470, 0.4],
  [26.8580, 80.9440, 0.3], [26.8578, 80.9445, 0.3],
  [26.8500, 80.9400, 0.5],
];

function confBadge(c){
  const cls = c >= 0.85 ? "high" : c >= 0.65 ? "med" : "low";
  return `<span class="badge ${cls}">${(c*100).toFixed(0)}%</span>`;
}

/* Simulated search "API" call */
function fetchEvents(query){
  return new Promise(resolve => {
    setTimeout(() => {
      const q = query.trim().toLowerCase();
      if(!q){ resolve(EVENTS); return; }
      resolve(EVENTS.filter(e =>
        e.camera.toLowerCase().includes(q) ||
        e.location.toLowerCase().includes(q) ||
        e.type.toLowerCase().includes(q) ||
        (e.vehicle && e.vehicle.toLowerCase().includes(q))
      ));
    }, 250); // simulated network latency
  });
}

function renderEvents(list){
  const body = document.getElementById("eventTableBody");
  document.getElementById("resultCount").textContent = `${list.length} event${list.length===1?"":"s"}`;
  if(list.length === 0){
    body.innerHTML = `<tr class="empty-row"><td colspan="6">No events match that search.</td></tr>`;
    return;
  }
  body.innerHTML = list.map(e => `
    <tr>
      <td class="mono">${e.time}</td>
      <td class="mono">${e.camera}</td>
      <td>${e.location}</td>
      <td>${e.type}</td>
      <td class="mono">${e.vehicle ? e.vehicle : '<span style="color:var(--muted)">—</span>'}</td>
      <td>${confBadge(e.confidence)}</td>
    </tr>
  `).join("");
}

async function runSearch(query){
  const results = await fetchEvents(query);
  renderEvents(results);
}

document.getElementById("searchBtn").addEventListener("click", () => {
  runSearch(document.getElementById("searchInput").value);
});
document.getElementById("searchInput").addEventListener("keydown", (e) => {
  if(e.key === "Enter") runSearch(e.target.value);
});
document.getElementById("clearBtn").addEventListener("click", () => {
  document.getElementById("searchInput").value = "";
  runSearch("");
});

const quickTags = ["CAM-03", "Loading Dock", "Loitering", "After-hours entry"];
document.getElementById("quickTags").innerHTML = quickTags.map(t =>
  `<span class="tag" data-q="${t}">${t}</span>`
).join("");
document.querySelectorAll(".tag").forEach(tag => {
  tag.addEventListener("click", () => {
    document.getElementById("searchInput").value = tag.dataset.q;
    runSearch(tag.dataset.q);
  });
});

/* ---------------- MAP ---------------- */
// Wrapped in try/catch: if the Leaflet map library fails to load (e.g. no
// network access to the CDN), that error must not stop the rest of the
// page — search, evidence, and watchlist all need to keep working.
let map, heatLayer, routeLine;

try{
  map = L.map('map', { zoomControl: true }).setView([26.8535, 80.9465], 15);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors',
    maxZoom: 19
  }).addTo(map);

  // force dashboard-friendly muted tile look
  document.getElementById("map").style.filter = "grayscale(0.3) brightness(0.95) contrast(1.02)";

  // Camera markers
  const cameraIcon = L.divIcon({
    className: '',
    html: `<div style="width:14px;height:14px;border-radius:50%;background:#4FB0A5;border:2px solid #20262B;box-shadow:0 0 0 3px rgba(79,176,165,0.3);"></div>`,
    iconSize: [14,14],
    iconAnchor: [7,7]
  });

  CAMERAS.forEach(cam => {
    L.marker([cam.lat, cam.lng], { icon: cameraIcon })
      .addTo(map)
      .bindPopup(`
        <b>${cam.id}</b><br>${cam.name}
        <div class="popup-cap-row">
          <button class="popup-cap-btn" onclick="window.captureFromCamera('${cam.id}','image')">📸 Capture photo</button>
          <button class="popup-cap-btn" onclick="window.captureFromCamera('${cam.id}','video')">🎥 Record clip</button>
        </div>
      `);
  });

  // Trajectory line connecting cameras in visit order
  const routeLatLngs = TRAJECTORY.map(c => [c.lat, c.lng]);
  routeLine = L.polyline(routeLatLngs, {
    color: '#4FB0A5',
    weight: 3,
    opacity: 0.85,
    dashArray: '1,8',
    lineCap: 'round'
  }).addTo(map);

  // Small direction markers along the route
  TRAJECTORY.forEach((cam, i) => {
    if(i === 0) return;
    L.circleMarker([cam.lat, cam.lng], {
      radius: 5, color: '#C97B4A', fillColor:'#C97B4A', fillOpacity: 1, weight: 1
    }).addTo(map).bindTooltip(`Stop ${i+1}: ${cam.id}`, { direction: 'top' });
  });

  // Heatmap overlay
  heatLayer = L.heatLayer(HEAT_POINTS, {
    radius: 32,
    blur: 24,
    maxZoom: 17,
    gradient: { 0.3: '#3A5B62', 0.5: '#4FB0A5', 0.75: '#C97B4A', 1: '#D9695C' }
  }).addTo(map);

  // Vehicle tracking layer (separate from the general trajectory route)
  let vehicleRouteLine = null;
  let vehicleMarkers = [];
  let routeLineOn = true; // general trajectory route starts visible

  var clearVehicleTracking = function(){
    if(vehicleRouteLine){ map.removeLayer(vehicleRouteLine); vehicleRouteLine = null; }
    vehicleMarkers.forEach(m => map.removeLayer(m));
    vehicleMarkers = [];
    document.getElementById("trackStatus").textContent = "";
    document.querySelectorAll("#eventTableBody tr").forEach(tr => tr.style.background = "");
  };

  var trackVehicle = function(plateRaw){
    const plate = plateRaw.trim().toUpperCase();
    if(!plate) return;

    clearVehicleTracking();

    const hits = EVENTS
      .filter(e => e.vehicle && e.vehicle.toUpperCase() === plate)
      .sort((a,b) => a.time.localeCompare(b.time));

    if(hits.length === 0){
      document.getElementById("trackStatus").innerHTML =
        `<span style="color:var(--red)">No detections found for "${plate}".</span>`;
      renderEvents(EVENTS.filter(() => false)); // show empty state via normal search too
      runSearch(plate);
      return;
    }

    // build path from the cameras that detected this vehicle, in time order
    const path = hits.map(h => {
      const cam = CAMERAS.find(c => c.id === h.camera);
      return { ...h, lat: cam.lat, lng: cam.lng, camName: cam.name };
    });

    // draw the vehicle's route and turn the route display "on"
    vehicleRouteLine = L.polyline(path.map(p => [p.lat, p.lng]), {
      color: '#D9695C',
      weight: 4,
      opacity: 0.9,
      lineCap: 'round'
    }).addTo(map);
    routeLineOn = true;

    const vehicleIcon = L.divIcon({
      className: '',
      html: `<div style="width:16px;height:16px;border-radius:50%;background:#D9695C;border:2px solid #20262B;box-shadow:0 0 0 4px rgba(217,105,92,0.3);"></div>`,
      iconSize: [16,16], iconAnchor: [8,8]
    });

    path.forEach((p, i) => {
      const marker = L.marker([p.lat, p.lng], { icon: vehicleIcon })
        .addTo(map)
        .bindPopup(`<b>${plate}</b><br>${p.camName} (${p.camera})<br>${p.time} — ${p.type}`);
      if(i === path.length - 1) marker.openPopup(); // latest known location
      vehicleMarkers.push(marker);
    });

    // pan/zoom the map to the vehicle's full tracked path
    map.fitBounds(vehicleRouteLine.getBounds(), { padding: [40,40] });

    const last = path[path.length - 1];
    document.getElementById("trackStatus").innerHTML =
      `<span style="color:var(--blue); font-weight:700;">${plate}</span> — ${hits.length} detection${hits.length===1?"":"s"} · last seen <span class="mono">${last.camName} (${last.camera})</span> at <span class="mono">${last.time}</span>`;

    // filter the event log to this vehicle's detections
    document.getElementById("searchInput").value = plate;
    runSearch(plate);
  };

  document.getElementById("trackBtn").addEventListener("click", () => {
    trackVehicle(document.getElementById("vehicleInput").value);
  });
  document.getElementById("vehicleInput").addEventListener("keydown", (e) => {
    if(e.key === "Enter") trackVehicle(e.target.value);
  });
  document.getElementById("clearTrackBtn").addEventListener("click", () => {
    document.getElementById("vehicleInput").value = "";
    clearVehicleTracking();
    document.getElementById("searchInput").value = "";
    runSearch("");
  });

  document.getElementById("toggleHeat").addEventListener("click", () => {
    if(map.hasLayer(heatLayer)) map.removeLayer(heatLayer); else heatLayer.addTo(map);
  });
  document.getElementById("toggleRoute").addEventListener("click", () => {
    if(map.hasLayer(routeLine)) map.removeLayer(routeLine); else routeLine.addTo(map);
  });
}catch(err){
  console.error("Map failed to initialize (camera map disabled, rest of the app continues):", err);
}

/* ---------------- WATCHLIST ---------------- */
let watchlist = [];

function renderWatchlist(){
  const list = document.getElementById("wlList");
  document.getElementById("wlCount").textContent = `${watchlist.length} entr${watchlist.length===1?"y":"ies"}`;
  if(watchlist.length === 0){
    list.innerHTML = `<div style="color:var(--muted); font-size:13px; padding: 4px 0;">No one on the watchlist yet. Add an entry using the form.</div>`;
    return;
  }
  const pClass = { high: 'high', med: 'med', low: 'low' };
  const pLabel = { high: 'HIGH', med: 'MEDIUM', low: 'LOW' };
  list.innerHTML = watchlist.map((w, idx) => `
    <div class="wl-item">
      <div>
        <div class="name">${w.name} <span class="priority badge ${pClass[w.priority]}">${pLabel[w.priority]}</span></div>
        <div class="meta">${w.type}${w.note ? " · " + w.note : ""}</div>
      </div>
      <button data-idx="${idx}" class="wlRemove">Remove</button>
    </div>
  `).join("");
  document.querySelectorAll(".wlRemove").forEach(btn => {
    btn.addEventListener("click", () => {
      watchlist.splice(Number(btn.dataset.idx), 1);
      renderWatchlist();
    });
  });
}

document.getElementById("wlForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const name = document.getElementById("wlName").value.trim();
  if(!name) return;
  watchlist.push({
    name,
    type: document.getElementById("wlType").value,
    priority: document.getElementById("wlPriority").value,
    note: document.getElementById("wlNote").value.trim()
  });
  e.target.reset();
  document.getElementById("wlPriority").value = "med";
  renderWatchlist();
});

/* ---------------- EVIDENCE: PHOTOS & VIDEOS ---------------- */
const MEDIA_KEY = "gridwatch_media_library";
let mediaLibrary = [];
let mediaLibraryIsFirstRun = false;

function loadMediaLibrary(){
  try{
    const raw = localStorage.getItem(MEDIA_KEY);
    if(raw){
      mediaLibrary = JSON.parse(raw);
      return;
    }
  }catch(err){
    console.error("Could not read stored media:", err);
  }
  // first-run example captures so the gallery isn't empty — these are camera-sourced too
  mediaLibraryIsFirstRun = true;
  const byId = id => CAMERAS.find(c => c.id === id);
  mediaLibrary = [
    { id: "demo1", kind: "image", name: "cam03_snapshot.jpg", dataUrl: captureFrameSVG(byId("CAM-03"), "image", "09:21:30"), camera: "CAM-03", vehicle: "DL04CD5678", time: "09:21:30", size: 0, auto: true, demo: true },
    { id: "demo2", kind: "image", name: "cam01_snapshot.jpg", dataUrl: captureFrameSVG(byId("CAM-01"), "image", "09:12:04"), camera: "CAM-01", vehicle: "UP32AB1234", time: "09:12:04", size: 0, auto: true, demo: true },
    { id: "demo3", kind: "image", name: "cam04_snapshot.jpg", dataUrl: captureFrameSVG(byId("CAM-04"), "image", "09:27:18"), camera: "CAM-04", vehicle: "UP32AB1234", time: "09:27:18", size: 0, auto: true, demo: true },
    { id: "demo4", kind: "image", name: "cam06_snapshot.jpg", dataUrl: captureFrameSVG(byId("CAM-06"), "image", "09:36:22"), camera: "CAM-06", vehicle: "", time: "09:36:22", size: 0, auto: true, demo: true }
  ];
}

function saveMediaLibrary(){
  try{
    localStorage.setItem(MEDIA_KEY, JSON.stringify(mediaLibrary));
    return true;
  }catch(err){
    console.error("Storage error:", err);
    return false;
  }
}

function formatBytes(bytes){
  if(bytes < 1024) return `${bytes} B`;
  if(bytes < 1024*1024) return `${(bytes/1024).toFixed(1)} KB`;
  return `${(bytes/1024/1024).toFixed(1)} MB`;
}

function renderMediaGrid(){
  const grid = document.getElementById("mediaGrid");
  const totalBytes = mediaLibrary.reduce((sum, m) => sum + (m.size || 0), 0);
  document.getElementById("mediaCount").textContent =
    `${mediaLibrary.length} file${mediaLibrary.length===1?"":"s"} · ${formatBytes(totalBytes)} stored`;

  if(mediaLibrary.length === 0){
    grid.innerHTML = `<div class="media-empty">No photos or videos captured yet.</div>`;
    return;
  }

  grid.innerHTML = mediaLibrary.map(m => {
    const cam = CAMERAS.find(c => c.id === m.camera);
    // Real recorded/uploaded video files have a data:video/... or blob: URL and can play in a <video> tag.
    // Simulated camera captures that fell back to a static frame use an SVG image thumb instead.
    const isPlayableVideo = m.kind === "video" && /^(data:video|blob:)/.test(m.dataUrl);
    const thumb = isPlayableVideo
      ? `<video class="media-thumb" src="${m.dataUrl}" muted autoplay loop playsinline preload="auto"></video>`
      : `<img class="media-thumb" src="${m.dataUrl}" alt="${m.name}">`;
    return `
      <div class="media-card">
        ${thumb}
        <span class="media-kind-badge">${m.kind === "video" ? "VIDEO" : "PHOTO"}</span>
        <button class="media-remove" data-id="${m.id}" title="Remove">✕</button>
        <div class="media-meta">
          <div class="cam" data-cam="${m.camera || ''}">${cam ? `${cam.id} · ${cam.name}` : "Unassigned"}</div>
          <div class="sub">${m.vehicle ? m.vehicle + " · " : ""}${m.time || ""}${m.auto ? ` · <span class="auto-tag">Auto-captured</span>` : ""}</div>
        </div>
      </div>
    `;
  }).join("");

  grid.querySelectorAll(".media-remove").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      mediaLibrary = mediaLibrary.filter(m => m.id !== btn.dataset.id);
      saveMediaLibrary();
      renderMediaGrid();
    });
  });

  // clicking a photo/video thumb opens it full-size (photos display, videos play)
  grid.querySelectorAll(".media-thumb").forEach((el, i) => {
    el.addEventListener("click", () => openLightbox(mediaLibrary[i]));
  });

  // clicking a camera name on a card locates it on the map (if the map loaded)
  grid.querySelectorAll(".cam[data-cam]").forEach(el => {
    el.addEventListener("click", (e) => {
      e.stopPropagation();
      if(!map) return;
      const cam = CAMERAS.find(c => c.id === el.dataset.cam);
      if(cam){
        map.setView([cam.lat, cam.lng], 17);
        L.popup().setLatLng([cam.lat, cam.lng]).setContent(`<b>${cam.id}</b><br>${cam.name}`).openOn(map);
        document.getElementById("panel-map").scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });
}

/* ---------------- MEDIA LIGHTBOX: display photos, play videos ---------------- */
function openLightbox(m){
  if(!m) return;
  const cam = CAMERAS.find(c => c.id === m.camera);
  const metaEl = document.getElementById("lightboxMeta");
  const mediaEl = document.getElementById("lightboxMedia");
  const isPlayableVideo = m.kind === "video" && /^(data:video|blob:)/.test(m.dataUrl);

  metaEl.textContent =
    `${cam ? `${cam.id} · ${cam.name}` : "Unassigned camera"}` +
    `${m.vehicle ? " · " + m.vehicle : ""} · ${m.time || ""}` +
    `${m.auto ? " · Auto-captured" : ""}` +
    `${m.kind === "video" ? " · VIDEO" : " · PHOTO"}`;

  mediaEl.innerHTML = isPlayableVideo
    ? `<video src="${m.dataUrl}" controls autoplay loop playsinline></video>`
    : `<img src="${m.dataUrl}" alt="${m.name}">`;

  document.getElementById("mediaLightbox").classList.add("open");
}

function closeLightbox(){
  document.getElementById("mediaLightbox").classList.remove("open");
  document.getElementById("lightboxMedia").innerHTML = ""; // stops any playing video
}

document.getElementById("lightboxClose").addEventListener("click", closeLightbox);
document.getElementById("mediaLightbox").addEventListener("click", (e) => {
  if(e.target.id === "mediaLightbox") closeLightbox();
});
document.addEventListener("keydown", (e) => {
  if(e.key === "Escape") closeLightbox();
});


/* ---------------- LIVE CAMERA CAPTURE → EVIDENCE ----------------
   Simulates each CCTV camera automatically capturing photos (and
   occasional short clips) as it detects activity. Every capture is
   pushed straight into the evidence media library so it shows up
   and is stored in the gallery above, same as a manual upload.
------------------------------------------------------------------- */

// Renders a "captured frame" placeholder that looks like a camera still,
// stamped with the camera name and the capture timestamp.
function captureFrameSVG(cam, kind, timeStr){
  const isVideo = kind === "video";
  const accent = isVideo ? "#D9695C" : "#4FB0A5";
  const playIcon = isVideo
    ? `<circle cx="200" cy="118" r="26" fill="rgba(32,38,43,0.55)"/>
       <polygon points="192,104 192,132 216,118" fill="#F4F7F7"/>`
    : "";
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='400' height='260'>
    <rect width='100%' height='100%' fill='#20262B'/>
    <rect width='100%' height='100%' fill='none' stroke='${accent}' stroke-width='3'/>
    <line x1='0' y1='60' x2='400' y2='60' stroke='#3A444C' stroke-width='1'/>
    <line x1='0' y1='200' x2='400' y2='200' stroke='#3A444C' stroke-width='1'/>
    <line x1='133' y1='60' x2='133' y2='200' stroke='#3A444C' stroke-width='1'/>
    <line x1='266' y1='60' x2='266' y2='200' stroke='#3A444C' stroke-width='1'/>
    ${playIcon}
    <circle cx='20' cy='22' r='5' fill='${accent}'/>
    <text x='34' y='27' font-family='monospace' font-size='13' fill='#F4F7F7' font-weight='bold'>${isVideo ? "REC" : "CAPTURED"}</text>
    <text x='20' y='245' font-family='monospace' font-size='14' fill='#F4F7F7' font-weight='bold'>${cam.id} · ${cam.name}</text>
    <text x='380' y='27' font-family='monospace' font-size='12' fill='#94A5AB' text-anchor='end'>${timeStr}</text>
  </svg>`;
  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
}

// Feature-detects in-browser video recording support
function canRecordVideo(){
  return typeof MediaRecorder !== "undefined" &&
    typeof HTMLCanvasElement !== "undefined" &&
    typeof HTMLCanvasElement.prototype.captureStream === "function";
}

// Records a short, real, playable clip by animating a canvas "camera frame"
// (scan line, blinking REC dot, live timestamp) and encoding it with
// MediaRecorder — this is genuine video data, not a static placeholder.
function recordCameraClip(cam, timeStr){
  return new Promise((resolve, reject) => {
    if(!canRecordVideo()){ reject(new Error("recording-unsupported")); return; }

    const canvas = document.createElement("canvas");
    canvas.width = 400;
    canvas.height = 260;
    const ctx = canvas.getContext("2d");
    const stream = canvas.captureStream(24);

    let recorder;
    try{
      recorder = new MediaRecorder(stream, { mimeType: "video/webm;codecs=vp8" });
    }catch(err){
      try{ recorder = new MediaRecorder(stream); }
      catch(err2){ reject(err2); return; }
    }

    const chunks = [];
    recorder.ondataavailable = (e) => { if(e.data && e.data.size) chunks.push(e.data); };
    recorder.onerror = (e) => reject(e.error || new Error("recorder-error"));
    recorder.onstop = () => {
      const blob = new Blob(chunks, { type: recorder.mimeType || "video/webm" });
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(new Error("blob-read-failed"));
      reader.readAsDataURL(blob);
    };

    const durationMs = 1800;
    const start = performance.now();

    function drawFrame(now){
      const t = now - start;
      ctx.fillStyle = "#20262B";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = "#D9695C";
      ctx.lineWidth = 3;
      ctx.strokeRect(1.5, 1.5, canvas.width - 3, canvas.height - 3);

      ctx.strokeStyle = "#3A444C";
      ctx.lineWidth = 1;
      [60, 200].forEach(y => { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); });
      [133, 266].forEach(x => { ctx.beginPath(); ctx.moveTo(x, 60); ctx.lineTo(x, 200); ctx.stroke(); });

      // moving scan line across the frame
      const scanX = (t / durationMs) * canvas.width;
      ctx.fillStyle = "rgba(217,105,92,0.35)";
      ctx.fillRect(scanX % canvas.width, 60, 3, 140);

      // blinking REC dot
      ctx.fillStyle = Math.floor(t / 300) % 2 === 0 ? "#D9695C" : "#7a3a34";
      ctx.beginPath(); ctx.arc(20, 22, 5, 0, Math.PI * 2); ctx.fill();

      ctx.fillStyle = "#F4F7F7";
      ctx.font = "bold 13px monospace";
      ctx.textAlign = "left";
      ctx.fillText("REC", 34, 27);
      ctx.font = "bold 14px monospace";
      ctx.fillText(`${cam.id} · ${cam.name}`, 20, 245);
      ctx.fillStyle = "#94A5AB";
      ctx.font = "12px monospace";
      ctx.textAlign = "right";
      ctx.fillText(timeStr, 380, 27);

      if(t < durationMs){
        requestAnimationFrame(drawFrame);
      }else{
        recorder.stop();
      }
    }

    recorder.start();
    requestAnimationFrame(drawFrame);
  });
}

// Creates a capture (photo or video) from a given camera and stores it in evidence.
async function addCapture(camId, kind, opts){
  const cam = CAMERAS.find(c => c.id === camId);
  if(!cam) return null;
  const options = opts || {};
  const now = new Date();
  const timeStr = now.toTimeString().slice(0,8);
  const label = kind === "video" ? "clip" : "snapshot";

  let dataUrl;
  if(kind === "video"){
    try{
      dataUrl = await recordCameraClip(cam, timeStr);
    }catch(err){
      // Browser can't record video — fall back to a still frame so the
      // capture still lands in evidence rather than being lost.
      dataUrl = captureFrameSVG(cam, kind, timeStr);
    }
  }else{
    dataUrl = captureFrameSVG(cam, kind, timeStr);
  }

  const ext = /^data:video/.test(dataUrl) ? "webm" : "jpg";
  const entry = {
    id: `cap_${Date.now()}_${Math.random().toString(36).slice(2,7)}`,
    kind,
    name: `${cam.id.toLowerCase()}_${label}_${timeStr.replace(/:/g, "")}.${ext}`,
    dataUrl,
    camera: cam.id,
    vehicle: options.vehicle || "",
    time: timeStr,
    size: 0,
    auto: options.auto !== false
  };

  mediaLibrary.unshift(entry);
  const ok = saveMediaLibrary();
  renderMediaGrid();

  showCaptureToast(ok
    ? `${kind === "video" ? "New video" : "New photo"} from ${cam.id} — ${cam.name} · added to Evidence`
    : `Captured, but storage is full — remove older evidence to keep saving.`);
  return entry;
}

// Expose for the map popup buttons (manual, on-demand capture from a specific camera)
window.captureFromCamera = function(camId, kind){
  addCapture(camId, kind, { auto: false });
};

function showCaptureToast(message){
  const wrap = document.getElementById("toastWrap");
  if(!wrap) return;
  const toast = document.createElement("div");
  toast.className = "capture-toast";
  toast.innerHTML = `<span class="rec"></span><span>${message}</span>`;
  wrap.appendChild(toast);
  setTimeout(() => toast.remove(), 4100);
}

// Auto-capture loop: at randomized intervals, a random camera "captures" a
// photo (mostly) or a short clip (occasionally) and it lands in evidence.
let autoCaptureTimer = null;
let autoCaptureOn = true;

function scheduleNextAutoCapture(){
  if(!autoCaptureOn) return;
  const delay = 9000 + Math.random() * 9000; // ~9-18s between captures
  autoCaptureTimer = setTimeout(() => {
    const cam = CAMERAS[Math.floor(Math.random() * CAMERAS.length)];
    const kind = Math.random() < 0.25 ? "video" : "image";
    addCapture(cam.id, kind, { auto: true });
    scheduleNextAutoCapture();
  }, delay);
}

function setAutoCapture(on){
  autoCaptureOn = on;
  const dot = document.getElementById("autoCaptureDot");
  if(dot) dot.classList.toggle("on", on);
  if(autoCaptureTimer){ clearTimeout(autoCaptureTimer); autoCaptureTimer = null; }
  if(on) scheduleNextAutoCapture();
}

document.getElementById("autoCaptureToggle").addEventListener("change", (e) => {
  setAutoCapture(e.target.checked);
});

document.getElementById("captureNowBtn").addEventListener("click", () => {
  const cam = CAMERAS[Math.floor(Math.random() * CAMERAS.length)];
  const kind = Math.random() < 0.3 ? "video" : "image";
  addCapture(cam.id, kind, { auto: false });
});

document.getElementById("clearMediaBtn").addEventListener("click", () => {
  if(mediaLibrary.length === 0) return;
  mediaLibrary = [];
  saveMediaLibrary();
  renderMediaGrid();
  document.getElementById("mediaStatus").textContent = "All stored evidence cleared.";
});

try{
  loadMediaLibrary();
  renderMediaGrid();
  setAutoCapture(true); // cameras start auto-capturing into evidence immediately

  // On first run, also generate a couple of real example video clips (in
  // addition to the example photos above) so the gallery shows both media
  // types right away. These use the same recording pipeline as any other
  // camera-triggered capture.
  if(mediaLibraryIsFirstRun){
    (async () => {
      try{
        await addCapture("CAM-02", "video", { auto: true, vehicle: "UP32AB1234" });
        await addCapture("CAM-05", "video", { auto: true });
      }catch(err){
        console.error("Example video generation failed:", err);
      }
    })();
  }
}catch(err){
  console.error("Evidence panel failed to initialize:", err);
}

/* init */
try{ runSearch(""); }catch(err){ console.error("Event search init failed:", err); }
try{ renderWatchlist(); }catch(err){ console.error("Watchlist init failed:", err); }

/* ---------------- NAV RAIL: scrollspy + smooth scroll ---------------- */
const navItems = document.querySelectorAll(".nav-item");
const trackedPanels = ["panel-search", "panel-events", "panel-map", "panel-evidence", "panel-watchlist"]
  .map(id => document.getElementById(id));

navItems.forEach(item => {
  item.addEventListener("click", () => {
    const target = document.getElementById(item.dataset.target);
    if(target){
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
});

function setActiveNav(id){
  navItems.forEach(item => {
    item.classList.toggle("active", item.dataset.target === id);
  });
}

const spyObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if(entry.isIntersecting){
      setActiveNav(entry.target.id);
    }
  });
}, { rootMargin: "-15% 0px -70% 0px", threshold: 0 });

trackedPanels.forEach(panel => { if(panel) spyObserver.observe(panel); });
setActiveNav("panel-search"); // default on load

/* ---------------- PANEL ENTRANCE ANIMATION ---------------- */
const revealObserver = new IntersectionObserver((entries, obs) => {
  entries.forEach((entry, i) => {
    if(entry.isIntersecting){
      entry.target.style.animationDelay = `${i * 0.05}s`;
      entry.target.classList.add("in-view");
      obs.unobserve(entry.target);
    }
  });
}, { threshold: 0.08 });

document.querySelectorAll(".panel").forEach(panel => revealObserver.observe(panel));

/* ---------------- SCROLL PROGRESS BAR ---------------- */
const progressBar = document.getElementById("progressBar");
function updateProgress(){
  const scrollTop = window.scrollY;
  const docHeight = document.documentElement.scrollHeight - window.innerHeight;
  const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
  progressBar.style.width = pct + "%";
}
window.addEventListener("scroll", updateProgress, { passive: true });
updateProgress();
</script>
