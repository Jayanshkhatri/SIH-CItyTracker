<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grid Watch — Camera Network Monitor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  :root{
    --bg: #37414A;
    --bg-grad: radial-gradient(1200px 600px at 15% -10%, rgba(79,176,165,0.10), transparent),
                radial-gradient(900px 500px at 100% 0%, rgba(201,123,74,0.06), transparent);
    --panel: #3F4A54;
    --panel-2: #48545F;
    --panel-raised: #526069;
    --line: #5C6B74;
    --line-soft: rgba(92,107,116,0.55);
    --text: #F4F7F7;
    --text-dim: #CDD7DA;
    --muted: #94A5AB;
    --ink: #20262B;
    --gold: #C97B4A;
    --gold-soft: rgba(201,123,74,0.18);
    --blue: #4FB0A5;
    --blue-soft: rgba(79,176,165,0.18);
    --red: #D9695C;
    --red-soft: rgba(217,105,92,0.16);
    --green: #6BBF8A;
    --green-soft: rgba(107,191,138,0.16);
    --shadow: 0 1px 2px rgba(0,0,0,0.14), 0 10px 24px -12px rgba(0,0,0,0.34);
    --radius: 10px;
  }
  *{ box-sizing: border-box; }
  ::selection{ background: rgba(91,159,227,0.35); }
  body{
    margin:0;
    background: var(--bg-grad), var(--bg);
    color: var(--text);
    font-family: 'Sora', sans-serif;
    font-size: 14.5px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .mono{ font-family: 'IBM Plex Mono', monospace; font-feature-settings: "ss01"; }

  header{
    position: sticky;
    top: 0;
    z-index: 900;
    padding: 20px 32px;
    border-bottom: 1px solid var(--line);
    background: rgba(55,65,74,0.9);
    backdrop-filter: blur(10px);
    display:flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand{ display:flex; align-items:center; gap: 12px; }
  .brand-mark{
    width: 34px; height: 34px;
    border-radius: 9px;
    background: linear-gradient(145deg, var(--blue), #2f5f96);
    display:flex; align-items:center; justify-content:center;
    box-shadow: var(--shadow);
    flex-shrink: 0;
  }
  .brand-mark svg{ width: 18px; height:18px; }
  header h1{
    margin:0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.1px;
    color: var(--text);
  }
  header h1 span{ color: var(--gold); font-weight: 800; }
  header .subtitle{
    font-size: 11.5px;
    color: var(--muted);
    font-weight: 500;
    margin-top: 1px;
  }
  header .status{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--text-dim);
    display:flex;
    align-items:center;
    gap: 8px;
    background: var(--panel-2);
    border: 1px solid var(--line);
    padding: 7px 14px;
    border-radius: 20px;
  }
  .dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-soft);
  }

  main.content{
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .panel{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .panel-head{
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    background: linear-gradient(180deg, rgba(255,255,255,0.015), transparent);
  }
  .panel-head-left{ display:flex; align-items:center; gap: 12px; }
  .step-num{
    width: 26px; height: 26px;
    border-radius: 7px;
    background: var(--blue-soft);
    color: var(--blue);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    display:flex; align-items:center; justify-content:center;
    flex-shrink: 0;
  }
  .panel-head h2{
    margin:0;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.1px;
  }
  .panel-head .hint{
    font-size: 12px;
    color: var(--muted);
    font-weight: 500;
  }
  .panel-body{ padding: 22px; }

  /* Search */
  .search-row{
    display:flex;
    gap: 10px;
  }
  input[type="text"], select, textarea{
    background: var(--panel-2);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 7px;
    padding: 10px 13px;
    font-family: 'Sora', sans-serif;
    font-size: 13.5px;
    font-weight: 500;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input[type="text"]::placeholder, textarea::placeholder{ color: var(--muted); font-weight: 400; }
  input[type="text"]:focus, select:focus, textarea:focus{
    border-color: var(--blue);
    box-shadow: 0 0 0 3px var(--blue-soft);
  }
  .search-row input{ flex:1; }
  button{
    background: var(--gold);
    color: #241A08;
    border: none;
    border-radius: 7px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13.5px;
    cursor: pointer;
    font-family: 'Sora', sans-serif;
    transition: filter 0.15s ease, transform 0.05s ease;
    white-space: nowrap;
  }
  button:hover{ filter: brightness(1.08); }
  button:active{ transform: translateY(1px); }
  button.ghost{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-dim);
    font-weight: 600;
  }
  button.ghost:hover{ border-color: var(--blue); color: var(--text); filter:none; }
  .search-tags{
    margin-top: 12px;
    display:flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--text-dim);
    border: 1px solid var(--line);
    background: var(--panel-2);
    padding: 4px 11px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tag:hover{ color: var(--blue); border-color: var(--blue); background: var(--blue-soft); }

  .divider{
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .field-label{
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text-dim);
    display:block;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* Table */
  table{ width:100%; border-collapse: collapse; }
  thead th{
    text-align:left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    padding: 0 14px 12px;
    font-weight: 700;
    border-bottom: 1px solid var(--line);
  }
  tbody td{
    padding: 12px 14px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 13.5px;
    vertical-align: middle;
    color: var(--text-dim);
  }
  tbody tr:hover{ background: rgba(91,159,227,0.05); }
  tbody tr:last-child td{ border-bottom: none; }
  .badge{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
    display:inline-block;
  }
  .badge.high{ background: var(--red-soft); color: var(--red); }
  .badge.med{ background: var(--gold-soft); color: var(--gold); }
  .badge.low{ background: var(--green-soft); color: var(--green); }
  .empty-row td{
    color: var(--muted);
    text-align:center;
    padding: 32px 14px;
    font-size: 13.5px;
  }

  /* map + legend */
  .map-wrap{ position: relative; }
  #map{ height: 440px; width: 100%; }
  .legend{
    position:absolute;
    bottom: 16px;
    left: 16px;
    z-index: 500;
    background: rgba(63,74,84,0.95);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 11.5px;
    color: var(--text-dim);
    display:flex;
    flex-direction: column;
    gap: 7px;
    box-shadow: var(--shadow);
  }
  .legend-item{ display:flex; align-items:center; gap: 9px; font-weight: 500; }
  .legend-swatch{ width:11px; height:11px; border-radius: 50%; flex-shrink:0; }
  .legend-line{ width:16px; height:3px; border-radius:2px; flex-shrink:0; }
  .legend-heat{
    width:16px; height:11px;
    background: linear-gradient(90deg, #3A5B62, #4FB0A5, #C97B4A, #D9695C);
    border-radius: 3px;
    flex-shrink:0;
  }
  .map-controls{
    display:flex; gap: 8px;
  }

  /* watchlist — stacked top to bottom */
  .watchlist-stack{
    display:flex;
    flex-direction: column;
    gap: 22px;
  }
  form.watchlist-form{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  form.watchlist-form .full{ grid-column: 1 / -1; }
  form.watchlist-form label{
    font-size: 11.5px;
    color: var(--muted);
    display:block;
    margin-bottom: 6px;
    font-weight: 600;
  }
  form.watchlist-form input, form.watchlist-form select, form.watchlist-form textarea{ width: 100%; }
  form.watchlist-form .submit-row{ grid-column: 1 / -1; display:flex; justify-content:flex-end; margin-top: 2px; }

  .wl-list-head{
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .wl-item{
    display:flex;
    justify-content: space-between;
    align-items:center;
    padding: 13px 16px;
    border: 1px solid var(--line);
    background: var(--panel-2);
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .wl-item .name{ font-weight: 700; font-size: 13.5px; display:flex; align-items:center; gap: 10px; }
  .wl-item .meta{ font-size: 11.5px; color: var(--muted); font-family: 'IBM Plex Mono', monospace; margin-top: 4px; }
  .wl-item button{
    background: transparent;
    border: 1px solid var(--line);
    color: var(--red);
    padding: 6px 12px;
    font-size: 11.5px;
    font-weight: 600;
  }
  .wl-item button:hover{ border-color: var(--red); background: var(--red-soft); filter:none; }
  .priority{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 20px;
  }

  @media (max-width: 780px){
    form.watchlist-form{ grid-template-columns: 1fr; }
    header{ padding: 16px 20px; }
    main{ padding: 20px 16px 60px; }
    .panel-body{ padding: 16px; }
  }

  /* progress bar */
  .progress-bar{
    position: fixed;
    top: 0; left: 0;
    height: 2.5px;
    width: 0%;
    background: linear-gradient(90deg, var(--blue), var(--gold));
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  /* layout: nav rail + content, top to bottom flow inside content */
  .layout{
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px 32px 80px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
  }
  .content{
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  /* (layout grid below positions nav-rail + content side by side) */

  /* vertical nav rail — sections listed top to bottom */
  .nav-rail{
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-rail-line{
    position: absolute;
    left: 21px;
    top: 8px;
    bottom: 8px;
    width: 1.5px;
    background: var(--line);
    z-index: 0;
  }
  .nav-item{
    position: relative;
    z-index: 1;
    display:flex;
    align-items:center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-item:hover{ color: var(--text-dim); background: var(--panel-2); }
  .nav-item .nav-dot{
    width: 27px; height: 27px;
    border-radius: 50%;
    background: var(--panel);
    border: 1.5px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .nav-item .nav-label{
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-item.active{ color: var(--text); }
  .nav-item.active .nav-dot{
    background: var(--blue);
    border-color: var(--blue);
    color: var(--ink);
    box-shadow: 0 0 0 4px var(--blue-soft);
  }
  .nav-item.active .nav-label{ color: var(--text); }

  @media (max-width: 980px){
    .layout{ grid-template-columns: 1fr; padding: 20px 16px 60px; }
    .nav-rail{
      position: sticky;
      top: 0;
      z-index: 800;
      flex-direction: row;
      overflow-x: auto;
      background: rgba(55,65,74,0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
      padding: 10px 4px;
      margin: -20px -16px 4px;
      gap: 6px;
    }
    .nav-rail-line{ display:none; }
    .nav-item .nav-label{ display:none; }
    .nav-item{ padding: 8px; }
  }

  /* panel entrance animation */
  .panel{
    opacity: 0;
    transform: translateY(14px);
  }
  .panel.in-view{
    animation: panelIn 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  @keyframes panelIn{
    to{ opacity: 1; transform: translateY(0); }
  }
  /* Evidence: camera-captured gallery */
  .media-status{
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--muted);
    min-height: 1em;
  }
  .media-grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 16px;
  }
  .media-card{
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }
  .media-thumb{
    width: 100%;
    aspect-ratio: 400 / 260;
    object-fit: cover;
    display:block;
    background: var(--panel-raised);
  }
  .media-kind-badge{
    position:absolute;
    top: 8px; left: 8px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 20px;
    background: rgba(32,38,43,0.75);
    color: var(--text);
    letter-spacing: 0.4px;
  }
  .media-remove{
    position:absolute;
    top: 8px; right: 8px;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: rgba(32,38,43,0.75);
    border: none;
    color: var(--text);
    font-size: 13px;
    line-height: 1;
    padding: 0;
    display:flex; align-items:center; justify-content:center;
    cursor: pointer;
  }
  .media-remove:hover{ background: var(--red); filter:none; }
  .media-meta{
    padding: 10px 12px;
  }
  .media-meta .cam{
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text);
    cursor: pointer;
  }
  .media-meta .cam:hover{ color: var(--blue); }
  .media-meta .sub{
    font-size: 11px;
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
    margin-top: 3px;
  }
  .media-empty{
    color: var(--muted);
    font-size: 13px;
    padding: 20px 0;
    text-align: center;
    grid-column: 1 / -1;
  }
  .media-meta .auto-tag{
    color: var(--blue);
    font-weight: 600;
  }

  /* Evidence panel head controls: auto-capture toggle + capture-now */
  .evidence-controls{
    display:flex;
    align-items:center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .auto-capture-toggle{
    display:flex;
    align-items:center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-dim);
  }
  .switch{
    position: relative;
    width: 34px;
    height: 19px;
    flex-shrink: 0;
  }
  .switch input{
    opacity: 0;
    width: 0;
    height: 0;
  }
  .switch-track{
    position:absolute;
    inset: 0;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .switch-track::before{
    content:"";
    position:absolute;
    width: 13px; height: 13px;
    left: 3px; top: 3px;
    background: var(--muted);
    border-radius: 50%;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .switch input:checked + .switch-track{
    background: var(--green-soft);
    border-color: var(--green);
  }
  .switch input:checked + .switch-track::before{
    transform: translateX(15px);
    background: var(--green);
  }
  .live-dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--muted);
    flex-shrink: 0;
  }
  .live-dot.on{
    background: var(--green);
    box-shadow: 0 0 0 3px var(--green-soft);
    animation: livePulse 1.6s ease-in-out infinite;
  }
  @keyframes livePulse{
    0%,100%{ opacity: 1; }
    50%{ opacity: 0.45; }
  }

  /* Map popup capture buttons */
  .popup-cap-row{
    display:flex;
    gap: 6px;
    margin-top: 8px;
  }
  .popup-cap-btn{
    font-family: 'Sora', sans-serif;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid var(--line);
    background: var(--panel-2);
    color: var(--text);
    border-radius: 6px;
    padding: 5px 9px;
    cursor: pointer;
  }
  .popup-cap-btn:hover{ border-color: var(--blue); color: var(--blue); }
  .leaflet-popup-content-wrapper, .leaflet-popup-tip{
    background: var(--panel-raised);
    color: var(--text);
  }

  /* Capture toast notifications */
  .toast-wrap{
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 2000;
    display:flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
  }
  .capture-toast{
    display:flex;
    align-items:center;
    gap: 10px;
    background: var(--panel-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    border-radius: 8px;
    padding: 11px 15px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text);
    max-width: 300px;
    animation: toastIn 0.25s ease forwards, toastOut 0.4s ease forwards 3.6s;
  }
  .capture-toast .rec{
    width:8px; height:8px; border-radius:50%;
    background: var(--red);
    flex-shrink:0;
    box-shadow: 0 0 0 3px var(--red-soft);
  }
  @keyframes toastIn{
    from{ opacity:0; transform: translateX(24px); }
    to{ opacity:1; transform: translateX(0); }
  }
  @keyframes toastOut{
    to{ opacity:0; transform: translateX(24px); }
  }

  /* Media lightbox: full display for photos, real playback for videos */
  .lightbox-overlay{
    position: fixed;
    inset: 0;
    background: rgba(15,18,20,0.86);
    display:none;
    align-items:center;
    justify-content:center;
    z-index: 3000;
    padding: 30px;
  }
  .lightbox-overlay.open{ display:flex; }
  .lightbox-inner{
    background: var(--panel-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    max-width: min(720px, 92vw);
    max-height: 88vh;
    overflow: hidden;
    box-shadow: var(--shadow);
    position: relative;
    display:flex;
    flex-direction:column;
  }
  .lightbox-close{
    position:absolute;
    top: 10px; right: 10px;
    width: 30px; height: 30px;
    border-radius: 50%;
    background: rgba(32,38,43,0.75);
    border: none;
    color: var(--text);
    font-size: 15px;
    cursor: pointer;
    z-index: 2;
    display:flex; align-items:center; justify-content:center;
  }
  .lightbox-close:hover{ background: var(--red); filter:none; }
  .lightbox-meta{
    padding: 12px 44px 12px 16px;
    font-size: 12.5px;
    color: var(--text-dim);
    border-bottom: 1px solid var(--line);
    font-family: 'IBM Plex Mono', monospace;
  }
  .lightbox-media{
    display:flex;
    align-items:center;
    justify-content:center;
    background: #000;
  }
  .lightbox-media img, .lightbox-media video{
    max-width: 100%;
    max-height: 72vh;
    display:block;
  }
  .media-thumb{ cursor: pointer; }

  @media (max-width: 780px){
    .evidence-controls{ width: 100%; justify-content: space-between; }
  }
</style>
</head>
<body>

<div class="progress-bar" id="progressBar"></div>
<div class="toast-wrap" id="toastWrap"></div>
<div class="lightbox-overlay" id="mediaLightbox">
  <div class="lightbox-inner">
    <button class="lightbox-close" id="lightboxClose" title="Close">✕</button>
    <div class="lightbox-meta" id="lightboxMeta"></div>
