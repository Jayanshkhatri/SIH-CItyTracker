    <div class="map-wrap">
      <div id="map"></div>
      <div class="legend">
        <div class="legend-item"><span class="legend-swatch" style="background:var(--blue)"></span> Camera</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--gold)"></span> Route stop</div>
        <div class="legend-item"><span class="legend-line" style="background:var(--blue)"></span> Camera trajectory</div>
        <div class="legend-item"><span class="legend-line" style="background:var(--red)"></span> Vehicle route</div>
      </div>
