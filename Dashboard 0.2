    </div>
  </section>

  <!-- EVENT TABLE -->
  <section class="panel" id="panel-events">
    <div class="panel-head">
      <div class="panel-head-left">
        <span class="step-num">2</span>
        <h2>Event log</h2>
      </div>
      <span class="hint" id="resultCount">12 events</span>
    </div>
    <div class="panel-body" style="padding-top:8px; overflow-x:auto;">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Camera</th>
            <th>Location</th>
